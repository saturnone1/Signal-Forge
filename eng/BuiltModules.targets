<Project>
  <!-- 모듈 목록은 DDSClient 생성기가 만든 선언을 사용한다. 특정 XML의 기본 목록은 없다. -->
  <Import Project="$(DDSClientRoot)/generated/BuiltModules.props"
    Condition="'$(DdsUseDefaultModules)' != 'false' and Exists('$(DDSClientRoot)/generated/BuiltModules.props')" />
  <Target Name="RequireBuiltModuleManifest" BeforeTargets="CollectPackageReferences;ResolveProjectReferences">
    <Error Condition="'$(DdsUseDefaultModules)' != 'false' and !Exists('$(DDSClientRoot)/generated/BuiltModules.props')"
      Text="DDSClient 모듈 목록을 먼저 생성하거나 DdsModuleSelectionFile로 사용할 모듈을 명시하세요." />
  </Target>
  <ItemGroup>
    <ProjectReference Include="@(DdsBuiltModule->'%(ProjectPath)')" />
    <Content Include="@(DdsBuiltModule->'%(Contract)')" Link="modules/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- 일반 빌드·publish 모두 표준 Content 복사 경로 하나만 사용한다. -->
  <Target Name="StageRuntimeModuleAssemblies" AfterTargets="ResolveReferences">
    <ItemGroup>
      <_RuntimeModuleAssembly Include="@(ReferenceCopyLocalPaths)" Condition="$([System.String]::Copy('%(Filename)').StartsWith('DdsAmbassador.Messages.'))" />
      <Content Include="@(_RuntimeModuleAssembly)" Link="modules/%(Filename)%(Extension)"
        CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <!-- 앱은 격리된 modules 경로만 사용한다. 생성 타입을 직접 참조하는 검사 프로그램은 루트 복사를 유지한다. -->
      <ReferenceCopyLocalPaths Remove="@(_RuntimeModuleAssembly)" Condition="'$(DdsCopyModuleAssembliesToRoot)' != 'true'" />
    </ItemGroup>
  </Target>
</Project>
