<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>5bf98269-8435-485b-94d1-5f4cb48bfd0a</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>
    <!-- src/ 폴더를 네임스페이스 경로에서 제외: src/Grpc/Foo.cs → ASAP.Grpc (not ASAP.src.Grpc) -->
    <RootNamespace>ASAP</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Grpc.AspNetCore" Version="2.64.0" />
    <PackageReference Include="Grpc.Net.Client" Version="2.64.0" />
    <PackageReference Include="Google.Protobuf" Version="3.31.1" />
    <PackageReference Include="Grpc.Tools" Version="2.64.0" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.9.2" />
    <PackageReference Include="MudBlazor" Version="7.15.0" />
    <PackageReference Include="NATS.Client.Abstractions" Version="2.8.0" />
    <PackageReference Include="NATS.Client.Core" Version="2.8.0" />
    <PackageReference Include="NATS.NKeys" Version="1.0.2" />

    <!-- RTI Connext DDS (rti/nupkg/에 .nupkg 4개; DDS 탭이 DynamicData로 사용) -->
    <PackageReference Include="Rti.ConnextDds" Version="7.3.1" />
    <PackageReference Include="Rti.ConnextDds.Extra" Version="7.3.1" />
    <PackageReference Include="Rti.ConnextDds.Native" Version="7.3.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- DdsSim message classes — GrpcServices="None" so only message types are generated, no stubs -->
    <Protobuf Include="DDSSim.proto" GrpcServices="None" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="samples\dds\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
