<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>5bf98269-8435-485b-94d1-5f4cb48bfd0a</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>
    <RootNamespace>ASAP</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="MudBlazor" Version="7.15.0" />

    <!-- RTI Connext DDS (rti/nupkg/에 .nupkg 4개; DDS 탭이 DynamicData로 사용) -->
    <PackageReference Include="Rti.ConnextDds" Version="7.3.1" />
    <PackageReference Include="Rti.ConnextDds.Extra" Version="7.3.1" />
    <PackageReference Include="Rti.ConnextDds.Native" Version="7.3.1" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="samples\dds\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
