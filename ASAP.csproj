<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>5bf98269-8435-485b-94d1-5f4cb48bfd0a</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..</DockerfileContext>
    <RootNamespace>ASAP</RootNamespace>
    <DDSClientRoot Condition="'$(DDSClientRoot)' == ''">$(MSBuildThisFileDirectory)../DDSClient/DDS_Nuget</DDSClientRoot>
    <DDSClientCoreProject>$(DDSClientRoot)/core/DdsAmbassador.DDSClient.Core.csproj</DDSClientCoreProject>
    <DefaultItemExcludes>$(DefaultItemExcludes);artifacts/**;**/bin/**;**/obj/**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.23.0" />
    <PackageReference Include="MudBlazor" Version="7.15.0" />

    <!-- Native runtime deployment only; DDS operations go through DDSClient. -->
    <PackageReference Include="Rti.ConnextDds.Extra" Version="7.3.1" />
    <PackageReference Include="Rti.ConnextDds.Native" Version="7.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(DDSClientCoreProject)" />
    <InternalsVisibleTo Include="SignalForge.DdsIntegrationTests" />
    <InternalsVisibleTo Include="SignalForge.SmokeTests" />
    <Compile Remove="tests\**\*.cs" />
    <Content Include="samples\dds\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Import Project="$(DdsModuleSelectionFile)" Condition="'$(DdsModuleSelectionFile)' != ''" />
  <Import Project="eng/BuiltModules.targets" />
</Project>
