{
  "name": "grpc-workbench",
  "version": "1.0.0",
  "description": "GrpcWorkbench - gRPC client testing tool",
  "scripts": {
    "install-libs": "npm install",
    "copy-libs": "npm run copy-bootstrap && npm run copy-signalr",
    "copy-bootstrap": "xcopy node_modules\\bootstrap\\dist wwwroot\\lib\\bootstrap\\dist /E /Y",
    "copy-signalr": "xcopy node_modules\\@microsoft\\signalr\\signalr.min.js wwwroot\\lib\\signalr\\ /Y",
    "setup": "npm install && npm run copy-libs"
  },
  "dependencies": {
    "bootstrap": "^5.3.0",
    "@microsoft/signalr": "^8.0.0"
  }
}
