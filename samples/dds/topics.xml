<?xml version="1.0" encoding="UTF-8"?>
<!--
  topics: Ambassador DDS topic distribution settings.
  RTI rtiddsgen uses DDSSim.xml for type generation. The runtime client reads
  this file to decide which topics may publish, subscribe, or both.

  When a new MSG struct is added to DDSSim.xml, add a matching <topic> item here.

  Attributes:
    name        MSG module struct name, also used as the DDS topic name
    qos_profile ReliableRealtime | BestEffort | ReliableTransient | Event | Ownership
    direction   Both | Publish | Subscribe
-->
<topics>
  <topic name="AirThreatInformation"     qos_profile="ReliableRealtime" direction="Both" />
  <topic name="MunitionInformation"      qos_profile="ReliableRealtime" direction="Both" />
  <topic name="GroundVehicleInformation" qos_profile="ReliableRealtime" direction="Both" />
  <topic name="UplinkInformation"        qos_profile="ReliableRealtime" direction="Both" />
  <topic name="DownlinkInformation"      qos_profile="ReliableRealtime" direction="Both" />
  <topic name="TimeTickInformation"      qos_profile="ReliableRealtime" direction="Both" />
  <topic name="SimulatorStatus"          qos_profile="ReliableRealtime" direction="Both" />
  <topic name="WeaponFire"               qos_profile="ReliableRealtime" direction="Both" />
  <topic name="TargetInformation"        qos_profile="ReliableRealtime" direction="Both" />
  <topic name="TrackNumberInfo"          qos_profile="ReliableRealtime" direction="Both" />
  <topic name="SetLog"                   qos_profile="ReliableRealtime" direction="Both" />
  <topic name="SetConfiguration"         qos_profile="ReliableRealtime" direction="Both" />
  <topic name="SetScenario"              qos_profile="ReliableRealtime" direction="Both" />
  <topic name="SetSimulation"            qos_profile="ReliableRealtime" direction="Both" />
  <topic name="Collision"                qos_profile="ReliableRealtime" direction="Both" />
  <topic name="MunitionDetonation"       qos_profile="ReliableRealtime" direction="Both" />
</topics>
