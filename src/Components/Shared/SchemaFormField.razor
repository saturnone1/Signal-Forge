@using ASAP.Models.Ui

@if (Field.Type == "boolean")
{
    <MudSwitch T="bool"
               Label="@Field.Name"
               Value="Field.BoolValue"
               ValueChanged="@((bool v) => { Field.BoolValue = v; OnChanged.InvokeAsync(); })"
               Color="Color.Primary" />
}
else if (Field.Type == "enum" && Field.EnumValues.Length > 0)
{
    <MudSelect T="string"
               Label="@Field.Name"
               Value="Field.Value"
               ValueChanged="@((string v) => { Field.Value = v; OnChanged.InvokeAsync(); })"
               Variant="Variant.Outlined"
               Margin="Margin.Dense">
        @foreach (var ev in Field.EnumValues)
        {
            <MudSelectItem T="string" Value="ev">@ev</MudSelectItem>
        }
    </MudSelect>
}
else if (Field.Type == "object" && Field.Children.Count > 0)
{
    <div class="d-flex align-center mb-1" style="gap:6px;">
        <MudIcon Icon="@Icons.Material.Filled.DataObject" Size="Size.Small"
                 Style="font-size:14px;color:var(--mud-palette-text-secondary);" />
        <span class="wb-panel-title">@Field.Name</span>
    </div>
    <div style="margin-left:10px;border-left:2px solid var(--mud-palette-lines-default);padding-left:10px;margin-bottom:6px;">
        @foreach (var child in Field.Children)
        {
            <div class="mb-2">
                <SchemaFormField Field="child" OnChanged="OnChanged" />
            </div>
        }
    </div>
}
else if (Field.Type == "union" && Field.Children.Count > 0)
{
    <div class="wb-subpanel pa-2 mb-2">
        <MudSelect T="string" Label="@($"{Field.Name} 활성 case")" Value="Field.Value"
                   ValueChanged="@((string value) => { Field.Value = value; OnChanged.InvokeAsync(); })"
                   Variant="Variant.Outlined" Margin="Margin.Dense">
            @foreach (var child in Field.Children)
            {
                <MudSelectItem T="string" Value="@child.Name">@child.Name</MudSelectItem>
            }
        </MudSelect>
        @if (Field.Children.FirstOrDefault(child => child.Name == Field.Value) is { } selected)
        {
            <SchemaFormField Field="selected" OnChanged="OnChanged" />
        }
    </div>
}
else if (Field.Type == "array" && Field.ItemTemplate != null)
{
    <div class="mb-1">
        <div class="d-flex align-center mb-1" style="gap:6px;">
            <MudIcon Icon="@Icons.Material.Filled.DataArray" Size="Size.Small"
                     Style="font-size:14px;color:var(--mud-palette-text-secondary);" />
            <span class="wb-panel-title">@Field.Name</span>
            <span style="font-size:.7rem;color:var(--mud-palette-text-disabled);">
                @(Field.ArrayItems.Count)개
            </span>
            <MudSpacer />
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Add"
                       Style="min-height:0;" OnClick="AddItem">추가</MudButton>
        </div>
        @if (Field.ArrayItems.Count > 0)
        {
            <div style="margin-left:8px;border-left:3px solid var(--mud-palette-primary);padding-left:10px;">
                @for (int i = 0; i < Field.ArrayItems.Count; i++)
                {
                    var item = Field.ArrayItems[i];
                    var idx = i;
                    <div class="wb-panel pa-2 mb-2">
                        <div class="d-flex align-center mb-1" style="gap:6px;">
                            <span class="wb-mono" style="font-size:.7rem;color:var(--mud-palette-text-disabled);">[@idx]</span>
                            <MudSpacer />
                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                           Size="Size.Small" Color="Color.Error"
                                           OnClick="@(() => RemoveItem(idx))" />
                        </div>
                        <SchemaFormField Field="item" OnChanged="OnChanged" />
                    </div>
                }
            </div>
        }
        else
        {
            <div style="margin-left:8px;font-size:.72rem;font-style:italic;color:var(--mud-palette-text-disabled);">
                비어있음 — "추가" 버튼으로 항목 생성
            </div>
        }
    </div>
}
else
{
    <MudTextField T="string"
                  Label="@GetLabel()"
                  Value="Field.Value"
                  ValueChanged="@((string v) => { Field.Value = v; OnChanged.InvokeAsync(); })"
                  Variant="Variant.Outlined"
                  Margin="Margin.Dense"
                  FullWidth="true"
                  Lines="@(Field.Type is "object" or "array" ? 3 : 1)"
                  Class="@(Field.Type is "object" or "array" ? "wb-mono" : null)" />
}

@code {
    [Parameter, EditorRequired] public SchemaField Field { get; set; } = null!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private string GetLabel() => string.IsNullOrEmpty(Field.Name)
        ? $"({Field.Type})"
        : $"{Field.Name} ({Field.Type})";

    private void AddItem()
    {
        var clone = Field.ItemTemplate!.DeepClone(Field.ArrayItems.Count.ToString());
        Field.ArrayItems.Add(clone);
        OnChanged.InvokeAsync();
    }

    private void RemoveItem(int index)
    {
        Field.ArrayItems.RemoveAt(index);
        for (int i = 0; i < Field.ArrayItems.Count; i++)
            Field.ArrayItems[i].Name = i.ToString();
        OnChanged.InvokeAsync();
    }
}
