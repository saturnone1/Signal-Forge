@using ASAP.Models.Dds
@using ASAP.Models.Session
@using ASAP.Services
@using Microsoft.AspNetCore.Components.Forms
@inject IDdsSessionService DdsSessions
@inject DdsProfileService ProfileStore
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<div class="wb-panel wb-panel--contain pa-3">
    <div class="wb-panel-kicker">새 DDS 세션</div>
    <div class="wb-panel-heading">개인 XML 프로필로 DDS 작업 공간 열기</div>
    <div class="wb-inline-note mt-2">
        프로필은 Signal Forge 서비스에 저장되어 모든 접속 화면에서 공유됩니다. DDSSim.xml, topics.xml, qos_profiles.xml 세 파일을 한 묶음으로 관리할 수 있어요.
    </div>

    <div class="wb-subpanel mt-3 pa-3">
        <div class="d-flex align-center flex-wrap" style="gap:8px;">
            <MudIcon Icon="@Icons.Material.Filled.AccountTree" Color="Color.Secondary" />
            <div style="flex:1 1 240px;min-width:0;">
                <div class="wb-panel-kicker">DDS XML 프로필</div>
                <div class="wb-panel-heading">메시지 타입과 토픽 구성을 선택</div>
            </div>
            @if (_profilesLoading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" />
            }
        </div>

        @if (_catalog != null)
        {
            <div class="d-flex align-center flex-wrap mt-3" style="gap:8px;">
                <MudSelect T="string" Value="_selectedProfileId" ValueChanged="SelectProfile"
                           Label="사용할 프로필" Variant="Variant.Outlined" Margin="Margin.Dense"
                           Style="flex:1 1 280px;">
                    @foreach (var profile in _catalog.Profiles.OrderBy(profile => profile.Name))
                    {
                        <MudSelectItem T="string" Value="@profile.Id">@profile.Name</MudSelectItem>
                    }
                </MudSelect>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Edit"
                           OnClick="BeginEditProfile" Disabled="@(SelectedProfile == null || SelectedProfileActiveSessionCount > 0)">편집</MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.CreateNewFolder"
                           OnClick="BeginNewDefaultProfile">새 프로필</MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.ContentCopy"
                           OnClick="BeginNewProfile" Disabled="@(SelectedProfile == null)">복제</MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Download"
                           OnClick="ExportSelectedProfile" Disabled="@(SelectedProfile == null)">세 XML 내보내기</MudButton>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="ReloadProfiles">새로고침</MudButton>
                <MudFileUpload T="IReadOnlyList<IBrowserFile>" FilesChanged="ImportProfileFiles"
                               Accept=".xml,text/xml,application/xml" MaximumFileCount="3">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Upload">세 XML 가져오기</MudButton>
                    </ActivatorContent>
                </MudFileUpload>
            </div>

            @if (_selectedValidation != null)
            {
                <div class="wb-inline-note mt-2">
                    @_selectedValidation.TypeCount 개 타입 · @_selectedValidation.TopicCount 개 토픽 · @_selectedValidation.QosProfileCount 개 QoS
                    · 마지막 저장 @SelectedProfile?.UpdatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm")
                </div>
            }
            @if (SelectedProfileActiveSessionCount > 0)
            {
                <div class="wb-inline-note mt-2" style="color:var(--mud-palette-warning);">
                    이 프로필의 고정 스냅샷으로 DDS 세션 @SelectedProfileActiveSessionCount 개가 통신 중입니다.
                    활성 세션을 보호하기 위해 원본 편집·삭제는 잠기며, 변경이 필요하면 복제하세요.
                </div>
            }

            @if (_editingProfile != null)
            {
                <div class="wb-panel mt-3 pa-3" style="border-color:color-mix(in srgb, var(--mud-palette-secondary) 50%, var(--mud-palette-lines-default));">
                    <div class="d-flex align-center" style="gap:8px;">
                        <div>
                            <div class="wb-panel-kicker">프로필 편집기</div>
                            <div class="wb-panel-heading">@(_editingOriginalId == null ? "새 프로필 만들기" : "프로필 수정")</div>
                        </div>
                        <MudSpacer />
                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="CancelProfileEdit">닫기</MudButton>
                    </div>

                    <MudTextField @bind-Value="_editingProfile.Name" Label="프로필 이름" Immediate="true"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3" />

                    <MudTabs Rounded="true" Border="true" Class="mt-3">
                        <MudTabPanel Text="메시지 타입" Icon="@Icons.Material.Filled.DataObject">
                            <div class="d-flex align-center mb-2" style="gap:8px;">
                                <MudFileUpload T="IBrowserFile" FilesChanged="LoadTypesIntoEditor" Accept=".xml,text/xml,application/xml">
                                    <ActivatorContent>
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.UploadFile">DDSSim.xml 불러오기</MudButton>
                                    </ActivatorContent>
                                </MudFileUpload>
                                <span class="wb-inline-note">XML 전체를 직접 수정하지 않고 IDL 타입 구조를 편집합니다.</span>
                            </div>
                            @if (_typeEditor == null)
                            {
                                <div class="wb-inline-note">타입 XML을 구조 편집기로 불러오지 못했습니다. 고급 타입 XML 탭에서 확인하세요.</div>
                            }
                            else
                            {
                                <DdsTypeEditor State="_typeEditor" OnChanged="MarkTypesDirty" OnTypeRenamed="OnTypeRenamed" />
                            }
                        </MudTabPanel>
                        <MudTabPanel Text="토픽" Icon="@Icons.Material.Filled.Hub">
                            <div class="d-flex align-center mb-2" style="gap:8px;">
                                <span class="wb-inline-note">DDSClient 계약에 따라 MSG struct와 같은 이름의 토픽, 방향, QoS를 관리합니다.</span>
                                <MudSpacer />
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                                           OnClick="AddTopic">토픽 추가</MudButton>
                            </div>
                            @if (_configEditor == null)
                            {
                                <div class="wb-inline-note">토픽/QoS XML을 구조 편집기로 불러오세요.</div>
                            }
                            else
                            {
                                @foreach (var topic in _configEditor.Topics)
                                {
                                    <div @key="topic.Id" class="wb-subpanel pa-2 mb-2">
                                        <div class="d-flex align-center flex-wrap" style="gap:8px;">
                                            <MudSelect T="string" Value="topic.Name"
                                                       ValueChanged="@((string value) => UpdateTopic(topic, item => item.Name = value))"
                                                       Label="MSG 타입 / 토픽 이름" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                       Style="flex:1 1 300px;">
                                                @foreach (var typeName in _availableTypes)
                                                {
                                                    <MudSelectItem T="string" Value="@typeName">@typeName</MudSelectItem>
                                                }
                                            </MudSelect>
                                            <MudSelect T="DdsTopicDirection" Value="topic.Direction"
                                                       ValueChanged="@((DdsTopicDirection value) => UpdateTopic(topic, item => item.Direction = value))"
                                                       Label="방향" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                       Style="min-width:140px;">
                                                <MudSelectItem Value="DdsTopicDirection.Both">Both</MudSelectItem>
                                                <MudSelectItem Value="DdsTopicDirection.Publish">Publish</MudSelectItem>
                                                <MudSelectItem Value="DdsTopicDirection.Subscribe">Subscribe</MudSelectItem>
                                            </MudSelect>
                                            <MudSelect T="string" Value="topic.QosProfileName"
                                                       ValueChanged="@((string value) => UpdateTopic(topic, item => item.QosProfileName = value))"
                                                       Label="QoS" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                       Style="min-width:180px;">
                                                @foreach (var qos in _configEditor.QosProfiles)
                                                {
                                                    <MudSelectItem T="string" Value="@qos.Name">@qos.Name</MudSelectItem>
                                                }
                                            </MudSelect>
                                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small"
                                                           title="토픽 삭제" OnClick="@(() => RemoveTopic(topic))" />
                                        </div>
                                    </div>
                                }
                            }
                        </MudTabPanel>
                        <MudTabPanel Text="QoS" Icon="@Icons.Material.Filled.Tune">
                            <div class="d-flex align-center mb-2" style="gap:8px;">
                                @if (_configEditor != null)
                                {
                                    <span class="wb-inline-note">
                                        DDSClient 고정 QoS 라이브러리: AmbassadorProfiles. 이름은 자동 유지됩니다.
                                    </span>
                                }
                                <MudSpacer />
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                                           OnClick="AddQosProfile">QoS 추가</MudButton>
                            </div>
                            @if (_configEditor != null)
                            {
                                @foreach (var qos in _configEditor.QosProfiles)
                                {
                                    <div @key="qos.Id" class="wb-subpanel pa-3 mb-3">
                                        <div class="d-flex align-center" style="gap:8px;">
                                            <MudTextField T="string" Value="qos.Name" ValueChanged="@((string value) => RenameQos(qos, value))"
                                                          Label="QoS 이름" Variant="Variant.Outlined" Margin="Margin.Dense"
                                                          Class="wb-flex-field" Immediate="true" />
                                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Color="Color.Error" Size="Size.Small"
                                                           Disabled="@(_configEditor.QosProfiles.Count <= 1)"
                                                           title="QoS 삭제" OnClick="@(() => RemoveQosProfile(qos))" />
                                        </div>
                                        <div class="wb-inline-note mt-1 mb-1">
                                            토픽에서 이 QoS 설정을 선택할 때 표시되는 이름입니다.
                                        </div>
                                        <MudGrid Spacing="2" Class="mt-1">
                                            <MudItem xs="12" md="6">
                                                <div class="wb-panel-kicker mb-1">Writer</div>
                                                <MudSelect T="string" Value="qos.WriterReliability"
                                                           ValueChanged="@((string value) => UpdateQos(qos, item => item.WriterReliability = value))"
                                                           Label="Reliability" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true">
                                                    <MudSelectItem T="string" Value="@DdsConfigProfileEditor.Reliable">Reliable</MudSelectItem>
                                                    <MudSelectItem T="string" Value="@DdsConfigProfileEditor.BestEffort">Best effort</MudSelectItem>
                                                </MudSelect>
                                                <MudSelect T="string" Value="qos.WriterHistory"
                                                           ValueChanged="@((string value) => UpdateQos(qos, item => item.WriterHistory = value))"
                                                           Label="History" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true">
                                                    <MudSelectItem T="string" Value="@DdsConfigProfileEditor.KeepLast">Keep last</MudSelectItem>
                                                    <MudSelectItem T="string" Value="@DdsConfigProfileEditor.KeepAll">Keep all</MudSelectItem>
                                                </MudSelect>
                                                @if (qos.WriterHistory == DdsConfigProfileEditor.KeepLast)
                                                {
                                                    <MudNumericField T="int" Value="qos.WriterHistoryDepth"
                                                                     ValueChanged="@((int value) => UpdateQos(qos, item => item.WriterHistoryDepth = value))"
                                                                     Label="History depth" Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                                }
                                                <MudSelect T="string" Value="qos.WriterDurability"
                                                           ValueChanged="@((string value) => UpdateQos(qos, item => item.WriterDurability = value))"
                                                           Label="Durability" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true">
                                                    @foreach (var durability in DurabilityOptions)
                                                    {
                                                        <MudSelectItem T="string" Value="@durability.Value">@durability.Label</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </MudItem>
                                            <MudItem xs="12" md="6">
                                                <div class="wb-panel-kicker mb-1">Reader</div>
                                                <MudSelect T="string" Value="qos.ReaderReliability"
                                                           ValueChanged="@((string value) => UpdateQos(qos, item => item.ReaderReliability = value))"
                                                           Label="Reliability" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true">
                                                    <MudSelectItem T="string" Value="@DdsConfigProfileEditor.Reliable">Reliable</MudSelectItem>
                                                    <MudSelectItem T="string" Value="@DdsConfigProfileEditor.BestEffort">Best effort</MudSelectItem>
                                                </MudSelect>
                                                <MudSelect T="string" Value="qos.ReaderHistory"
                                                           ValueChanged="@((string value) => UpdateQos(qos, item => item.ReaderHistory = value))"
                                                           Label="History" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true">
                                                    <MudSelectItem T="string" Value="@DdsConfigProfileEditor.KeepLast">Keep last</MudSelectItem>
                                                    <MudSelectItem T="string" Value="@DdsConfigProfileEditor.KeepAll">Keep all</MudSelectItem>
                                                </MudSelect>
                                                @if (qos.ReaderHistory == DdsConfigProfileEditor.KeepLast)
                                                {
                                                    <MudNumericField T="int" Value="qos.ReaderHistoryDepth"
                                                                     ValueChanged="@((int value) => UpdateQos(qos, item => item.ReaderHistoryDepth = value))"
                                                                     Label="History depth" Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                                }
                                                <MudSelect T="string" Value="qos.ReaderDurability"
                                                           ValueChanged="@((string value) => UpdateQos(qos, item => item.ReaderDurability = value))"
                                                           Label="Durability" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true">
                                                    @foreach (var durability in DurabilityOptions)
                                                    {
                                                        <MudSelectItem T="string" Value="@durability.Value">@durability.Label</MudSelectItem>
                                                    }
                                                </MudSelect>
                                            </MudItem>
                                        </MudGrid>
                                    </div>
                                }
                            }
                        </MudTabPanel>
                        <MudTabPanel Text="DDSSim.xml" Icon="@Icons.Material.Filled.Code">
                            <div class="d-flex align-center mb-2" style="gap:8px;">
                                <MudFileUpload T="IBrowserFile" FilesChanged="LoadTypesIntoEditor" Accept=".xml,text/xml,application/xml">
                                    <ActivatorContent>
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.UploadFile">DDSSim.xml 불러오기</MudButton>
                                    </ActivatorContent>
                                </MudFileUpload>
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ApplyStructuredTypesToXml"
                                           Disabled="@(!_structuredTypesDirty)"
                                           StartIcon="@Icons.Material.Filled.Code">구조 변경을 XML에 반영</MudButton>
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ReloadStructuredTypes"
                                           Disabled="@_structuredTypesDirty"
                                           StartIcon="@Icons.Material.Filled.Sync">XML을 구조 편집기에 반영</MudButton>
                                <span class="wb-inline-note">include, annotation 및 RTI 전용 요소는 이 탭에서 보존·편집할 수 있습니다.</span>
                            </div>
                            @if (_structuredTypesDirty)
                            {
                                <div class="wb-inline-note mb-2">메시지 타입 변경사항을 먼저 XML에 반영하면 원문 XML을 편집할 수 있습니다.</div>
                            }
                            <MudTextField T="string" Value="_editingProfile.DdsSimXml" ValueChanged="OnRawDdsSimXmlChanged" Lines="18" Immediate="true"
                                          Variant="Variant.Outlined" Margin="Margin.Dense"
                                          Disabled="@_structuredTypesDirty" Class="wb-mono" />
                        </MudTabPanel>
                        <MudTabPanel Text="topics.xml" Icon="@Icons.Material.Filled.Code">
                            <div class="d-flex align-center mb-2" style="gap:8px;">
                                <MudFileUpload T="IBrowserFile" FilesChanged="LoadTopicsIntoEditor" Accept=".xml,text/xml,application/xml">
                                    <ActivatorContent>
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.UploadFile">topics.xml 불러오기</MudButton>
                                    </ActivatorContent>
                                </MudFileUpload>
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ApplyStructuredConfigToXml"
                                           Disabled="@(!_structuredConfigDirty)"
                                           StartIcon="@Icons.Material.Filled.Code">구조 변경을 XML에 반영</MudButton>
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ReloadStructuredConfig"
                                           Disabled="@_structuredConfigDirty"
                                           StartIcon="@Icons.Material.Filled.Sync">XML을 구조 편집기에 반영</MudButton>
                                <span class="wb-inline-note">DDSClient 형식: &lt;topic name="..." qos_profile="..." direction="..." /&gt;</span>
                            </div>
                            @if (_structuredConfigDirty)
                            {
                                <div class="wb-inline-note mb-2">토픽/QoS 변경사항을 먼저 두 XML에 반영하면 원문을 편집할 수 있습니다.</div>
                            }
                            <MudTextField T="string" Value="_editingProfile.TopicsXml" ValueChanged="OnRawTopicsXmlChanged" Lines="18" Immediate="true"
                                           Variant="Variant.Outlined" Margin="Margin.Dense"
                                           Disabled="@_structuredConfigDirty"
                                           Class="wb-mono" />
                        </MudTabPanel>
                        <MudTabPanel Text="qos_profiles.xml" Icon="@Icons.Material.Filled.Code">
                            <div class="d-flex align-center mb-2" style="gap:8px;">
                                <MudFileUpload T="IBrowserFile" FilesChanged="LoadQosProfilesIntoEditor" Accept=".xml,text/xml,application/xml">
                                    <ActivatorContent>
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.UploadFile">qos_profiles.xml 불러오기</MudButton>
                                    </ActivatorContent>
                                </MudFileUpload>
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ApplyStructuredConfigToXml"
                                           Disabled="@(!_structuredConfigDirty)"
                                           StartIcon="@Icons.Material.Filled.Code">구조 변경을 XML에 반영</MudButton>
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ReloadStructuredConfig"
                                           Disabled="@_structuredConfigDirty"
                                           StartIcon="@Icons.Material.Filled.Sync">XML을 구조 편집기에 반영</MudButton>
                                <span class="wb-inline-note">UI에 없는 multicast, liveliness 등 RTI 정책도 원문에서 보존됩니다.</span>
                            </div>
                            @if (_structuredConfigDirty)
                            {
                                <div class="wb-inline-note mb-2">토픽/QoS 변경사항을 먼저 두 XML에 반영하면 원문을 편집할 수 있습니다.</div>
                            }
                            <MudTextField T="string" Value="_editingProfile.QosProfilesXml" ValueChanged="OnRawQosProfilesXmlChanged" Lines="18" Immediate="true"
                                          Variant="Variant.Outlined" Margin="Margin.Dense"
                                          Disabled="@_structuredConfigDirty"
                                          Class="wb-mono" />
                        </MudTabPanel>
                    </MudTabs>

                    @if (!string.IsNullOrWhiteSpace(_profileError))
                    {
                        <div class="wb-inline-note mt-2" style="color:var(--mud-palette-error);">@_profileError</div>
                    }

                    <div class="d-flex align-center flex-wrap mt-3" style="gap:8px;">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Save" OnClick="SaveProfile"
                                   Disabled="@IsEditingProfileInUse">검증 후 저장</MudButton>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="CancelProfileEdit">취소</MudButton>
                        <MudSpacer />
                        @if (_editingOriginalId != null && _catalog.Profiles.Count > 1)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.DeleteOutline" OnClick="DeleteEditingProfile"
                                       Disabled="@IsEditingProfileInUse">
                                @(_deleteArmed ? "한 번 더 눌러 삭제" : "프로필 삭제")
                            </MudButton>
                        }
                    </div>
                </div>
            }
        }
        else if (!_profilesLoading)
        {
            <div class="wb-inline-note mt-3" style="color:var(--mud-palette-error);">@_profileError</div>
        }
    </div>

    <div class="wb-home-form mt-3">
        <MudTextField @bind-Value="_name" Label="세션 이름"
                      Placeholder="비워 두면 프로필 이름으로 자동 생성"
                      Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudNumericField @bind-Value="_domainId" Label="Domain ID" Min="0" Max="232"
                         Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudSelect T="DdsDiscoveryMode" @bind-Value="_discoveryMode" Label="검색 방식"
                   Variant="Variant.Outlined" Margin="Margin.Dense">
            <MudSelectItem Value="DdsDiscoveryMode.Unicast">유니캐스트 (로컬 피어)</MudSelectItem>
            <MudSelectItem Value="DdsDiscoveryMode.Multicast">멀티캐스트</MudSelectItem>
        </MudSelect>
        @if (_discoveryMode == DdsDiscoveryMode.Multicast)
        {
            <MudTextField @bind-Value="_multicast" Label="멀티캐스트 주소 (선택)" Placeholder="RTI 기본 주소 사용"
                          Variant="Variant.Outlined" Margin="Margin.Dense" />
        }
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="wb-inline-note mt-2" style="color:var(--mud-palette-error);">@_error</div>
    }

    <div class="d-flex mt-3" style="gap:8px;">
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="Submit" Disabled="@(_creating || _profilesLoading || SelectedProfile == null || _editingProfile != null)"
                   StartIcon="@Icons.Material.Filled.AddLink">
            @if (_creating)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <text>생성 중…</text>
            }
            else
            {
                <text>선택 프로필로 DDS 세션 생성</text>
            }
        </MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="OnCancelled">취소</MudButton>
    </div>
</div>

@code {
    [Parameter] public EventCallback<DdsSession> OnCreated { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }

    private DdsProfileCatalog? _catalog;
    private string? _selectedProfileId;
    private DdsXmlProfile? _editingProfile;
    private string? _editingOriginalId;
    private DdsConfigEditorState? _configEditor;
    private DdsTypeEditorState? _typeEditor;
    private List<string> _availableTypes = [];
    private bool _structuredConfigDirty;
    private bool _structuredTypesDirty;
    private DdsProfileValidationResult? _selectedValidation;
    private bool _profilesLoading = true;
    private bool _deleteArmed;
    private string? _profileError;

    private string _name = string.Empty;
    private int _domainId;
    private DdsDiscoveryMode _discoveryMode = DdsDiscoveryMode.Unicast;
    private string _multicast = string.Empty;
    private bool _creating;
    private string? _error;

    private static readonly (string Value, string Label)[] DurabilityOptions =
    [
        (DdsConfigProfileEditor.Volatile, "Volatile"),
        (DdsConfigProfileEditor.TransientLocal, "Transient local"),
        (DdsConfigProfileEditor.Transient, "Transient"),
        (DdsConfigProfileEditor.Persistent, "Persistent"),
    ];

    private DdsXmlProfile? SelectedProfile
        => _catalog?.Profiles.FirstOrDefault(profile => profile.Id == _selectedProfileId);

    private int SelectedProfileActiveSessionCount
        => string.IsNullOrWhiteSpace(_selectedProfileId) ? 0 : DdsSessions.GetByProfileId(_selectedProfileId).Count;

    private bool IsEditingProfileInUse
        => _editingOriginalId != null && DdsSessions.GetByProfileId(_editingOriginalId).Count > 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            _catalog = await ProfileStore.LoadAsync();
            _selectedProfileId = _catalog.Profiles.FirstOrDefault()?.Id;
            RefreshSelectedValidation();
        }
        catch (Exception ex)
        {
            _profileError = $"서비스 프로필을 불러오지 못했습니다: {ex.Message}";
        }
        finally
        {
            _profilesLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void SelectProfile(string profileId)
    {
        if (_catalog == null) return;
        _selectedProfileId = profileId;
        _editingProfile = null;
        _editingOriginalId = null;
        RefreshSelectedValidation();
    }

    private async Task ReloadProfiles()
    {
        _profilesLoading = true;
        _profileError = null;
        try
        {
            var selectedId = _selectedProfileId;
            _catalog = await ProfileStore.LoadAsync();
            _selectedProfileId = _catalog.Profiles.Any(profile => profile.Id == selectedId)
                ? selectedId
                : _catalog.Profiles.FirstOrDefault()?.Id;
            CancelProfileEdit();
            RefreshSelectedValidation();
        }
        catch (Exception ex)
        {
            _profileError = $"서비스 프로필을 불러오지 못했습니다: {ex.Message}";
        }
        finally
        {
            _profilesLoading = false;
        }
    }

    private void BeginEditProfile()
    {
        if (SelectedProfile == null) return;
        if (SelectedProfileActiveSessionCount > 0)
        {
            _profileError = "통신 중인 DDS 세션이 사용하는 프로필은 편집할 수 없습니다. 프로필을 복제해 변경하세요.";
            return;
        }
        _editingProfile = CloneForEdit(SelectedProfile);
        _editingOriginalId = SelectedProfile.Id;
        _profileError = null;
        _deleteArmed = false;
        LoadProfileEditors();
    }

    private void BeginNewProfile()
    {
        if (SelectedProfile == null) return;
        _editingProfile = SelectedProfile.Copy(UniqueProfileName($"{SelectedProfile.Name} 복사본"));
        _editingOriginalId = null;
        _profileError = null;
        _deleteArmed = false;
        LoadProfileEditors();
    }

    private async Task BeginNewDefaultProfile()
    {
        try
        {
            var defaults = await ProfileStore.CreateDefaultCatalogAsync();
            _editingProfile = defaults.Profiles[0].Copy(UniqueProfileName("새 DDS 프로필"));
            _editingOriginalId = null;
            _profileError = null;
            _deleteArmed = false;
            LoadProfileEditors();
        }
        catch (Exception ex)
        {
            _profileError = $"기본 DDS 세 파일을 불러오지 못했습니다: {ex.Message}";
        }
    }

    private void CancelProfileEdit()
    {
        _editingProfile = null;
        _editingOriginalId = null;
        _profileError = null;
        _deleteArmed = false;
        _configEditor = null;
        _typeEditor = null;
        _availableTypes = [];
        _structuredConfigDirty = false;
        _structuredTypesDirty = false;
    }

    private async Task SaveProfile()
    {
        if (_catalog == null || _editingProfile == null) return;

        try
        {
            if (_structuredTypesDirty && _typeEditor != null)
            {
                _editingProfile.DdsSimXml = DdsTypeProfileEditor.Apply(_editingProfile.DdsSimXml, _typeEditor);
                _structuredTypesDirty = false;
            }
            if (_structuredConfigDirty && _configEditor != null)
            {
                var files = DdsConfigProfileEditor.Apply(_editingProfile.TopicsXml, _editingProfile.QosProfilesXml, _configEditor);
                _editingProfile.TopicsXml = files.TopicsXml;
                _editingProfile.QosProfilesXml = files.QosProfilesXml;
                _structuredConfigDirty = false;
            }
            var validation = DdsProfileService.Validate(_editingProfile);
            _editingProfile.Name = _editingProfile.Name.Trim();
            _editingProfile.UpdatedAtUtc = DateTimeOffset.UtcNow;

            var catalogToSave = CloneCatalog(_catalog);
            if (_editingOriginalId == null)
            {
                catalogToSave.Profiles.Add(_editingProfile);
            }
            else
            {
                var index = catalogToSave.Profiles.FindIndex(profile => profile.Id == _editingOriginalId);
                if (index < 0) throw new InvalidOperationException("수정할 프로필을 찾지 못했습니다.");
                _editingProfile.Id = _editingOriginalId;
                catalogToSave.Profiles[index] = _editingProfile;
            }

            await ProfileStore.SaveAsync(catalogToSave);
            _catalog = catalogToSave;
            _selectedProfileId = _editingProfile.Id;
            _selectedValidation = validation;
            Snackbar.Add($"DDS 프로필 저장: {_editingProfile.Name}", Severity.Success);
            CancelProfileEdit();
        }
        catch (Exception ex)
        {
            _profileError = ex.Message;
        }
    }

    private async Task DeleteEditingProfile()
    {
        if (_catalog == null || _editingOriginalId == null || _catalog.Profiles.Count <= 1) return;
        if (!_deleteArmed)
        {
            _deleteArmed = true;
            return;
        }

        try
        {
            var catalogToSave = CloneCatalog(_catalog);
            var removed = catalogToSave.Profiles.FirstOrDefault(profile => profile.Id == _editingOriginalId);
            catalogToSave.Profiles.RemoveAll(profile => profile.Id == _editingOriginalId);
            await ProfileStore.SaveAsync(catalogToSave);
            _catalog = catalogToSave;
            _selectedProfileId = _catalog.Profiles[0].Id;
            Snackbar.Add($"DDS 프로필 삭제: {removed?.Name}", Severity.Info);
            CancelProfileEdit();
            RefreshSelectedValidation();
        }
        catch (Exception ex)
        {
            _profileError = ex.Message;
        }
    }

    private async Task ExportSelectedProfile()
    {
        if (SelectedProfile == null) return;
        try
        {
            await JS.InvokeVoidAsync("workbench.downloadText", DdsProfileFiles.DdsSimFileName,
                SelectedProfile.DdsSimXml, "application/xml;charset=utf-8");
            await JS.InvokeVoidAsync("workbench.downloadText", DdsProfileFiles.TopicsFileName,
                SelectedProfile.TopicsXml, "application/xml;charset=utf-8");
            await JS.InvokeVoidAsync("workbench.downloadText", DdsProfileFiles.QosProfilesFileName,
                SelectedProfile.QosProfilesXml, "application/xml;charset=utf-8");
            Snackbar.Add("DDSSim.xml, topics.xml, qos_profiles.xml 내보내기 완료", Severity.Success);
        }
        catch (Exception ex)
        {
            _profileError = $"DDS 세 파일 내보내기 실패: {ex.Message}";
        }
    }

    private async Task ImportProfileFiles(IReadOnlyList<IBrowserFile>? files)
    {
        if (files == null || _catalog == null) return;

        try
        {
            if (files.Count != 3)
                throw new InvalidOperationException("DDSSim.xml, topics.xml, qos_profiles.xml 세 파일을 동시에 선택하세요.");
            var duplicates = files.GroupBy(file => file.Name, StringComparer.Ordinal)
                .FirstOrDefault(group => group.Count() > 1);
            if (duplicates != null)
                throw new InvalidOperationException($"중복 선택된 파일이 있습니다: {duplicates.Key}");

            var contents = new Dictionary<string, string>(StringComparer.Ordinal);
            foreach (var file in files)
            {
                var maxSize = file.Name switch
                {
                    DdsProfileFiles.DdsSimFileName => 16 * 1024 * 1024,
                    DdsProfileFiles.TopicsFileName => 4 * 1024 * 1024,
                    DdsProfileFiles.QosProfilesFileName => 8 * 1024 * 1024,
                    _ => throw new InvalidOperationException($"허용되지 않은 파일명입니다: {file.Name}"),
                };
                contents.Add(file.Name, await ReadBrowserFile(file, maxSize));
            }
            var imported = DdsProfileFiles.CreateProfile(UniqueProfileName("가져온 DDS 프로필"), contents);
            var catalogToSave = CloneCatalog(_catalog);
            catalogToSave.Profiles.Add(imported);
            await ProfileStore.SaveAsync(catalogToSave);
            _catalog = catalogToSave;
            _selectedProfileId = imported.Id;
            RefreshSelectedValidation();
            Snackbar.Add($"DDS 프로필 가져오기: {imported.Name}", Severity.Success);
        }
        catch (Exception ex)
        {
            _profileError = ex.Message;
        }
    }

    private async Task LoadTypesIntoEditor(IBrowserFile? file)
    {
        if (file == null || _editingProfile == null) return;
        try
        {
            RequireFileName(file, DdsProfileFiles.DdsSimFileName);
            OnRawDdsSimXmlChanged(await ReadBrowserFile(file, 16 * 1024 * 1024));
            ReloadStructuredTypes();
        }
        catch (Exception ex) { _profileError = ex.Message; }
    }

    private async Task LoadTopicsIntoEditor(IBrowserFile? file)
    {
        if (file == null || _editingProfile == null) return;
        try
        {
            RequireFileName(file, DdsProfileFiles.TopicsFileName);
            OnRawTopicsXmlChanged(await ReadBrowserFile(file, 4 * 1024 * 1024));
            ReloadStructuredConfig();
        }
        catch (Exception ex) { _profileError = ex.Message; }
    }

    private async Task LoadQosProfilesIntoEditor(IBrowserFile? file)
    {
        if (file == null || _editingProfile == null) return;
        try
        {
            RequireFileName(file, DdsProfileFiles.QosProfilesFileName);
            OnRawQosProfilesXmlChanged(await ReadBrowserFile(file, 8 * 1024 * 1024));
            ReloadStructuredConfig();
        }
        catch (Exception ex) { _profileError = ex.Message; }
    }

    private void LoadProfileEditors()
    {
        ReloadStructuredTypes();
        RefreshAvailableTypes();
        ReloadStructuredConfig();
    }

    private void OnRawDdsSimXmlChanged(string xml)
    {
        if (_editingProfile == null) return;
        _editingProfile.DdsSimXml = xml;
        _structuredTypesDirty = false;
        RefreshAvailableTypes();
    }

    private void ReloadStructuredTypes()
    {
        if (_editingProfile == null) return;
        try
        {
            _typeEditor = DdsTypeProfileEditor.Parse(_editingProfile.DdsSimXml);
            _structuredTypesDirty = false;
            _profileError = null;
            RefreshAvailableTypes();
        }
        catch (Exception ex)
        {
            _typeEditor = null;
            _profileError = $"메시지 타입 구조를 불러오지 못했습니다: {ex.Message}";
        }
    }

    private void MarkTypesDirty()
    {
        _structuredTypesDirty = true;
        RefreshAvailableTypes();
    }

    private void OnTypeRenamed(DdsTypeRename rename)
    {
        if (_configEditor == null) return;
        if (rename.OldName.StartsWith("MSG::", StringComparison.Ordinal) && rename.NewName.StartsWith("MSG::", StringComparison.Ordinal))
        {
            var oldTopicName = rename.OldName["MSG::".Length..];
            var newTopicName = rename.NewName["MSG::".Length..];
            foreach (var topic in _configEditor.Topics.Where(topic => string.Equals(topic.Name, oldTopicName, StringComparison.Ordinal)))
                topic.Name = newTopicName;
        }
        _structuredConfigDirty = true;
        RefreshAvailableTypes();
    }

    private void ApplyStructuredTypesToXml()
    {
        if (_editingProfile == null || _typeEditor == null) return;
        try
        {
            _editingProfile.DdsSimXml = DdsTypeProfileEditor.Apply(_editingProfile.DdsSimXml, _typeEditor);
            _structuredTypesDirty = false;
            _profileError = null;
            RefreshAvailableTypes();
        }
        catch (Exception ex)
        {
            _profileError = ex.Message;
        }
    }

    private void RefreshAvailableTypes()
    {
        _availableTypes = [];
        if (_editingProfile == null) return;

        if (_typeEditor != null)
        {
            _availableTypes = _typeEditor.Declarations
                .Where(type => type.Kind == DdsTypeProfileEditor.StructKind &&
                               string.Equals(type.ModulePath, "MSG", StringComparison.Ordinal))
                .Select(type => type.Name)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(name => name, StringComparer.OrdinalIgnoreCase)
                .ToList();
            return;
        }

        try
        {
            _availableTypes = ASAP.Dds.DdsTypeParser.Parse(_editingProfile.DdsSimXml)
                .Values
                .Where(type => type.Kind == DdsTypeKind.Struct &&
                               type.QualifiedName?.StartsWith("MSG::", StringComparison.Ordinal) == true)
                .Select(type => type.QualifiedName!["MSG::".Length..])
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .OrderBy(name => name, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch
        {
            // 편집 중인 불완전 XML은 저장 시 상세 오류를 표시한다.
        }
    }

    private void OnRawTopicsXmlChanged(string xml)
    {
        if (_editingProfile == null) return;
        _editingProfile.TopicsXml = xml;
        _structuredConfigDirty = false;
    }

    private void OnRawQosProfilesXmlChanged(string xml)
    {
        if (_editingProfile == null) return;
        _editingProfile.QosProfilesXml = xml;
        _structuredConfigDirty = false;
    }

    private void ReloadStructuredConfig()
    {
        if (_editingProfile == null) return;
        try
        {
            _configEditor = DdsConfigProfileEditor.Parse(_editingProfile.TopicsXml, _editingProfile.QosProfilesXml);
            _structuredConfigDirty = false;
            _profileError = null;
        }
        catch (Exception ex)
        {
            _configEditor = null;
            _profileError = $"토픽/QoS 구조를 불러오지 못했습니다: {ex.Message}";
        }
    }

    private void ApplyStructuredConfigToXml()
    {
        if (_editingProfile == null || _configEditor == null) return;

        try
        {
            var files = DdsConfigProfileEditor.Apply(_editingProfile.TopicsXml, _editingProfile.QosProfilesXml, _configEditor);
            _editingProfile.TopicsXml = files.TopicsXml;
            _editingProfile.QosProfilesXml = files.QosProfilesXml;
            _structuredConfigDirty = false;
            _profileError = null;
        }
        catch (Exception ex)
        {
            _profileError = ex.Message;
        }
    }

    private void AddTopic()
    {
        if (_configEditor == null) return;
        var index = _configEditor.Topics.Count + 1;
        _configEditor.Topics.Add(new DdsTopicEditorItem
        {
            Name = _availableTypes.FirstOrDefault(typeName =>
                       _configEditor.Topics.All(topic => !string.Equals(topic.Name, typeName, StringComparison.Ordinal)))
                   ?? $"Message{index}",
            QosProfileName = _configEditor.QosProfiles.FirstOrDefault()?.Name ?? string.Empty,
        });
        _structuredConfigDirty = true;
    }

    private void RemoveTopic(DdsTopicEditorItem topic)
    {
        if (_configEditor == null) return;
        _configEditor.Topics.Remove(topic);
        _structuredConfigDirty = true;
    }

    private void UpdateTopic(DdsTopicEditorItem topic, Action<DdsTopicEditorItem> update)
    {
        update(topic);
        _structuredConfigDirty = true;
    }

    private void AddQosProfile()
    {
        if (_configEditor == null) return;
        var existing = _configEditor.QosProfiles.Select(profile => profile.Name).ToHashSet(StringComparer.OrdinalIgnoreCase);
        var index = 1;
        while (existing.Contains($"QosProfile{index}")) index++;
        _configEditor.QosProfiles.Add(new DdsQosEditorItem { Name = $"QosProfile{index}" });
        _structuredConfigDirty = true;
    }

    private void RenameQos(DdsQosEditorItem qos, string value)
    {
        if (_configEditor == null) return;
        var previousName = qos.Name;
        qos.Name = value;
        foreach (var topic in _configEditor.Topics.Where(topic =>
                     string.Equals(topic.QosProfileName, previousName, StringComparison.OrdinalIgnoreCase)))
        {
            topic.QosProfileName = value;
        }
        _structuredConfigDirty = true;
    }

    private void RemoveQosProfile(DdsQosEditorItem qos)
    {
        if (_configEditor == null || _configEditor.QosProfiles.Count <= 1) return;
        _configEditor.QosProfiles.Remove(qos);
        var fallback = _configEditor.QosProfiles[0].Name;
        foreach (var topic in _configEditor.Topics.Where(topic =>
                     string.Equals(topic.QosProfileName, qos.Name, StringComparison.OrdinalIgnoreCase)))
        {
            topic.QosProfileName = fallback;
        }
        _structuredConfigDirty = true;
    }

    private void UpdateQos(DdsQosEditorItem qos, Action<DdsQosEditorItem> update)
    {
        update(qos);
        _structuredConfigDirty = true;
    }

    private async Task Submit()
    {
        _error = null;
        var selectedProfile = SelectedProfile;
        if (selectedProfile == null)
        {
            _error = "사용할 DDS 프로필을 선택하세요.";
            return;
        }

        _creating = true;
        try
        {
            var transport = new DdsTransportSettings
            {
                DomainId = _domainId,
                DiscoveryMode = _discoveryMode,
                MulticastAddress = string.IsNullOrWhiteSpace(_multicast) ? null : _multicast.Trim(),
            };
            var session = await Task.Run(() => ProfileStore.CreateSessionAsync(
                selectedProfile.Id, selectedProfile.UpdatedAtUtc, profile => DdsSessions.Create(new DdsSessionCreateRequest
                {
                    Name = string.IsNullOrWhiteSpace(_name) ? $"{profile.Name} domain {_domainId}" : _name.Trim(),
                    ProfileId = profile.Id,
                    ProfileName = profile.Name,
                    ProfileUpdatedAtUtc = profile.UpdatedAtUtc,
                    Transport = transport,
                    DdsSimXmlContent = profile.DdsSimXml,
                    TopicsXmlContent = profile.TopicsXml,
                    QosProfilesXmlContent = profile.QosProfilesXml,
                })));
            Snackbar.Add($"DDS 세션 생성: {session.Name}", Severity.Success);
            await OnCreated.InvokeAsync(session);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _creating = false;
        }
    }

    private void RefreshSelectedValidation()
    {
        _selectedValidation = null;
        _profileError = null;
        if (SelectedProfile == null) return;

        try
        {
            _selectedValidation = DdsProfileService.Validate(SelectedProfile);
        }
        catch (Exception ex)
        {
            _profileError = $"선택한 프로필 검증 실패: {ex.Message}";
        }
    }

    private static DdsXmlProfile CloneForEdit(DdsXmlProfile source) => new()
    {
        Id = source.Id,
        Name = source.Name,
        DdsSimXml = source.DdsSimXml,
        TopicsXml = source.TopicsXml,
        QosProfilesXml = source.QosProfilesXml,
        UpdatedAtUtc = source.UpdatedAtUtc,
    };

    private static DdsProfileCatalog CloneCatalog(DdsProfileCatalog source) => new()
    {
        Version = source.Version,
        Revision = source.Revision,
        Profiles = source.Profiles.Select(CloneForEdit).ToList(),
    };

    private static async Task<string> ReadBrowserFile(IBrowserFile file, long maxSize)
    {
        using var stream = file.OpenReadStream(maxSize);
        using var reader = new StreamReader(stream);
        return await reader.ReadToEndAsync();
    }

    private static void RequireFileName(IBrowserFile file, string expectedFileName)
    {
        if (!string.Equals(file.Name, expectedFileName, StringComparison.Ordinal))
            throw new InvalidOperationException($"이 위치에는 파일명이 정확히 '{expectedFileName}'인 파일을 불러오세요.");
    }

    private string UniqueProfileName(string requestedName)
    {
        var baseName = string.IsNullOrWhiteSpace(requestedName) ? "가져온 DDS 프로필" : requestedName.Trim();
        if (_catalog == null) return baseName;
        var existing = _catalog.Profiles.Select(profile => profile.Name).ToHashSet(StringComparer.OrdinalIgnoreCase);
        if (!existing.Contains(baseName)) return baseName;
        var index = 2;
        while (existing.Contains($"{baseName} ({index})")) index++;
        return $"{baseName} ({index})";
    }

}
