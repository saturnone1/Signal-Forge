@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using GrpcWorkbench.Models.Dds
@using GrpcWorkbench.Models.Session
@using GrpcWorkbench.Models.Ui
@using GrpcWorkbench.Services
@using GrpcWorkbench.Dds
@inject IDdsSessionService DdsSessions
@inject DdsStateService DdsState
@inject WorkbenchStateService GrpcState
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@implements IDisposable

@if (Session == null)
{
    <div class="wb-empty"><div>DDS 세션이 선택되지 않았습니다</div></div>
}
else
{
    <div class="wb-panel wb-panel--major wb-panel--contain pa-3 mb-4">
        <div class="d-flex align-center flex-wrap mb-2" style="gap:8px;">
            <MudIcon Icon="@Icons.Material.Filled.Cable" Size="Size.Small" Color="Color.Success" />
            <div>
                <div class="wb-panel-kicker">DDS 세션</div>
                <div class="wb-panel-heading">@Session.Name · domain @Session.Transport.DomainId</div>
            </div>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@Session.Topics.Count 토픽</MudChip>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@Session.Types.Count 타입</MudChip>
            @if (Session.QosProfiles.Count > 0)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">QoS: @string.Join(",", Session.QosProfiles)</MudChip>
            }
        </div>

        <div class="wb-subpanel mb-3 pa-3">
            <div class="wb-panel-kicker">기본 정보</div>
            <div class="wb-home-form mt-2">
                <div class="wb-code" style="font-size:.74rem;">
                    <span style="color:var(--mud-palette-text-secondary);">세션 ID</span><br />
                    <span class="wb-mono">@Session.SessionId</span>
                </div>
                <div class="wb-code" style="font-size:.74rem;">
                    <span style="color:var(--mud-palette-text-secondary);">생성 시각</span><br />
                    @Session.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                </div>
                <div class="wb-code" style="font-size:.74rem;">
                    <span style="color:var(--mud-palette-text-secondary);">Domain ID</span><br />
                    @Session.Transport.DomainId
                </div>
                <div class="wb-code" style="font-size:.74rem;">
                    <span style="color:var(--mud-palette-text-secondary);">멀티캐스트</span><br />
                    @(string.IsNullOrWhiteSpace(Session.Transport.MulticastAddress) ? "(미설정)" : Session.Transport.MulticastAddress)
                </div>
                <div class="wb-code" style="font-size:.74rem;">
                    <span style="color:var(--mud-palette-text-secondary);">Allow Interfaces</span><br />
                    @(Session.Transport.AllowInterfaces.Count == 0 ? "(없음)" : string.Join(", ", Session.Transport.AllowInterfaces))
                </div>
                <div class="wb-code" style="font-size:.74rem;">
                    <span style="color:var(--mud-palette-text-secondary);">Deny Interfaces</span><br />
                    @(Session.Transport.DenyInterfaces.Count == 0 ? "(없음)" : string.Join(", ", Session.Transport.DenyInterfaces))
                </div>
                <div class="wb-code" style="font-size:.74rem;">
                    <span style="color:var(--mud-palette-text-secondary);">송신/수신 버퍼</span><br />
                    @(Session.Transport.SendBufferSize?.ToString() ?? "default") / @(Session.Transport.ReceiveBufferSize?.ToString() ?? "default")
                </div>
                <div class="wb-code" style="font-size:.74rem;">
                    <span style="color:var(--mud-palette-text-secondary);">업로드 XML</span><br />
                    @(string.IsNullOrWhiteSpace(Session.TypesXmlFileName) ? "types.xml 미기록" : Session.TypesXmlFileName) ·
                    @(string.IsNullOrWhiteSpace(Session.ConfigXmlFileName) ? "dds-config.xml 미기록" : Session.ConfigXmlFileName)
                </div>
            </div>

            <div class="mt-3">
                <div class="d-flex align-center" style="gap:8px;">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">
                        DDSSim XML @(Session.TypesXmlContent?.Length ?? 0) bytes
                    </MudChip>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Visibility"
                               OnClick="@(() => _showTypesXml = !_showTypesXml)">
                        @(_showTypesXml ? "숨기기" : "내용 보기")
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Download"
                               OnClick="DownloadTypesXml"
                               Disabled="@(Session.TypesXmlContent == null)">
                        저장
                    </MudButton>
                </div>
                @if (_showTypesXml)
                {
                    <MudTextField Value="@GetTypesXmlText()" ReadOnly="true" Lines="8"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Label="DDSSim XML" />
                }
            </div>

            <div class="mt-2">
                <div class="d-flex align-center" style="gap:8px;">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">
                        dds-config XML @(Session.ConfigXmlContent?.Length ?? 0) bytes
                    </MudChip>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Visibility"
                               OnClick="@(() => _showConfigXml = !_showConfigXml)">
                        @(_showConfigXml ? "숨기기" : "내용 보기")
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Download"
                               OnClick="DownloadConfigXml"
                               Disabled="@(Session.ConfigXmlContent == null)">
                        저장
                    </MudButton>
                </div>
                @if (_showConfigXml)
                {
                    <MudTextField Value="@GetConfigXmlText()" ReadOnly="true" Lines="8"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Label="dds-config XML" />
                }
            </div>
        </div>

    </div>
    <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <div class="wb-panel wb-panel--major wb-panel--contain pa-3">
                    <div class="d-flex align-center mb-2" style="gap:8px;">
                        <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Small" Color="Color.Info" />
                        <div>
                            <div class="wb-panel-kicker">수신</div>
                            <div class="wb-panel-heading">구독 샘플</div>
                        </div>
                        <MudSelect T="string"
                                   Label="수신 토픽"
                                   Value="@_subscriptionTopicName"
                                   ValueChanged="OnSubscriptionTopicChanged"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Class="wb-select wb-select--comfortable wb-select--ellipsis"
                                   Style="min-width:260px;">
                            @foreach (var t in Session.Topics)
                            {
                                <MudSelectItem T="string" Value="@t.TopicName">
                                    @($"{t.TopicName} · {t.TypeName} · {t.Direction}")
                                </MudSelectItem>
                            }
                        </MudSelect>
                        @if (CurrentSubscription != null)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Class="ma-0">활성</MudChip>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@CurrentSubscription.ReceivedCount 수신</MudChip>
                        }
                        <MudSpacer />
                        @if (CanSubscribeCurrentTopic)
                        {
                            @if (CurrentSubscription == null)
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.PlayArrow"
                                           OnClick="StartSubscribe">구독</MudButton>
                            }
                            else
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Stop"
                                           OnClick="@(() => StopSubscribe(CurrentSubscription.SubscriptionId))">중지</MudButton>
                            }
                        }
                        else
                        {
                            <div class="wb-inline-note">수신 가능한 토픽을 선택하세요</div>
                        }
                    </div>

                    @if (_subscriptionTopic != null)
                    {
                        <div class="wb-inline-note mb-2">@($"type: {_subscriptionTopic.TypeName} · qos: {_subscriptionTopic.QosProfileName} · dir: {_subscriptionTopic.Direction}")</div>
                    }

                    @if (CurrentSubscription != null)
                    {
                        var samples = DdsState.SnapshotSamples(CurrentSubscription.SubscriptionId, 50);
                        @if (samples.Count == 0)
                        {
                            <div class="wb-empty"><div>아직 수신된 샘플 없음</div></div>
                        }
                        else
                        {
                            <div class="wb-message-split">
                                <div class="wb-scroll wb-message-list">
                                    @foreach (var s in samples)
                                    {
                                        <button type="button"
                                                class="wb-call-row wb-message-row @(_selectedSampleSeq == s.SequenceNumber ? "is-selected" : null)"
                                                @onclick="@(() => _selectedSampleSeq = s.SequenceNumber)">
                                            <div class="wb-message-row-main">
                                                <span class="wb-mono">@s.ReceivedAt.ToLocalTime().ToString("HH:mm:ss")</span>
                                                <span>#@s.SequenceNumber</span>
                                            </div>
                                        </button>
                                    }
                                </div>
                                <div class="wb-message-content">
                                    @{ var sel = samples.FirstOrDefault(x => x.SequenceNumber == _selectedSampleSeq) ?? samples.First(); }
                                    <JsonDataView Json="@sel.JsonData" />
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="wb-empty"><div>선택한 토픽의 수신 샘플이 아직 없습니다</div></div>
                    }
                </div>
            </MudItem>

            <MudItem xs="12" md="6">
                <div class="wb-panel wb-panel--major wb-panel--contain pa-3">
                    <div class="d-flex align-center mb-2" style="gap:8px;">
                        <MudIcon Icon="@Icons.Material.Filled.AutoMode" Size="Size.Small" Color="Color.Primary" />
                        <div>
                            <div class="wb-panel-kicker">DDS 자동화</div>
                            <div class="wb-panel-heading">트리거와 시나리오를 한 흐름으로 구성</div>
                        </div>
                    </div>
                    <DdsTriggerPanel Session="Session" Embedded="true" />

                    <div class="wb-subpanel pa-3">
                        <div class="d-flex align-center mb-2" style="gap:8px;">
                            <MudIcon Icon="@Icons.Material.Filled.PlaylistPlay" Size="Size.Small" Color="Color.Secondary" />
                            <div>
                                <div class="wb-panel-kicker">시나리오</div>
                                <div class="wb-panel-heading">토픽 선택과 메시지 편집을 여기서 처리</div>
                            </div>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@Session.ScenarioSteps.Count 단계</MudChip>
                            <MudSpacer />
                            <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Description"
                                       OnClick="LoadScenarioDraftTemplate"
                                       Disabled="_scenarioDraftTopic == null">기본값 불러오기</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="AddScenarioStep"
                                       Disabled="@(!CanPublishScenarioDraft)">단계 추가</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.PlayArrow"
                                   OnClick="RunScenario"
                                   Disabled="@(Session.ScenarioSteps.Count == 0 || _runningScenario)">
                            실행
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Stop"
                                   OnClick="StopScenario"
                                   Disabled="@(!_runningScenario)">
                            중단
                        </MudButton>
                    </div>

                    <div class="wb-home-form mb-2">
                        <MudSelect T="string" Label="시나리오 대상 토픽"
                                   Value="@_scenarioDraftTopicName"
                                   ValueChanged="OnScenarioDraftTopicChanged"
                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Class="wb-select wb-select--comfortable wb-select--ellipsis">
                            @foreach (var t in Session.Topics)
                            {
                                <MudSelectItem T="string" Value="@t.TopicName">
                                    @($"{t.TopicName} · {t.TypeName} · {t.Direction} · {t.QosProfileName}")
                                </MudSelectItem>
                            }
                        </MudSelect>
                        <div class="wb-code" style="font-size:.74rem;">
                            <span style="color:var(--mud-palette-text-secondary);">선택 토픽</span><br />
                            @if (_scenarioDraftTopic != null)
                            {
                                @($"type: {_scenarioDraftTopic.TypeName} · qos: {_scenarioDraftTopic.QosProfileName} · dir: {_scenarioDraftTopic.Direction}")
                            }
                            else
                            {
                                <text>토픽을 선택하세요</text>
                            }
                        </div>
                    </div>

                    @if (_scenarioDraftTopic != null && FindGrpcMatch(_scenarioDraftTopic.TopicName) is string match)
                    {
                        <div class="d-flex align-center mb-2" style="gap:6px;">
                            <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Size="Size.Small" Color="Color.Success" />
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Class="ma-0">
                                ambassador 매칭: @match
                            </MudChip>
                        </div>
                    }

                    @if (!CanPublishScenarioDraft)
                    {
                        <div class="wb-inline-note mb-2">발행 가능한 토픽을 시나리오 대상으로 선택하세요</div>
                    }
                    else if (_scenarioDraftSchemaFields.Count == 0)
                    {
                        <MudTextField @bind-Value="_scenarioDraftJson" Lines="8" Variant="Variant.Outlined"
                                      Label="시나리오 Payload JSON" Margin="Margin.Dense" />
                    }
                    else
                    {
                        <div class="d-flex flex-wrap align-center mb-2" style="gap:8px;">
                            <MudText Typo="Typo.caption" Style="color:var(--mud-palette-text-secondary);margin:0;">
                                시나리오 Payload 편집
                            </MudText>
                            <MudSpacer />
                            <MudToggleGroup T="bool" Value="_scenarioDraftRawJsonMode" ValueChanged="OnScenarioDraftRawModeChanged"
                                            Color="Color.Primary" Size="Size.Small" CheckMark="false"
                                            SelectionMode="SelectionMode.SingleSelection">
                                <MudToggleItem Value="false" Text="계층" />
                                <MudToggleItem Value="true" Text="JSON" />
                            </MudToggleGroup>
                        </div>

                        @if (!_scenarioDraftRawJsonMode)
                        {
                            <div class="wb-scroll mt-2" style="max-height:34vh;overflow-y:auto;">
                                @foreach (var field in _scenarioDraftSchemaFields)
                                {
                                    <div class="mb-2">
                                        <SchemaFormField Field="field" OnChanged="BuildScenarioDraftJsonFromForm" />
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <MudTextField @bind-Value="_scenarioDraftJson" Label="시나리오 Payload JSON"
                                          Variant="Variant.Outlined" Lines="10" FullWidth="true"
                                          Class="mt-2 wb-mono" Style="font-size:.8rem;" />
                        }
                    }

                    <div class="wb-home-form mb-2">
                        <MudNumericField @bind-Value="Session.ScenarioOptions.CycleCount" Label="반복 회수"
                                         Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudNumericField @bind-Value="Session.ScenarioOptions.DefaultStepDelayMs" Label="기본 단계 지연(ms)"
                                         Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudCheckBox @bind-Value="Session.ScenarioOptions.StopOnError" Label="오류 시 즉시 중단" Color="Color.Warning" />
                    </div>

                    <div class="d-flex align-center mb-2" style="gap:8px;">
                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Download"
                                   OnClick="ExportScenarioJson"
                                   Disabled="@(Session.ScenarioSteps.Count == 0)">저장</MudButton>
                        <MudFileUpload T="IBrowserFile" FilesChanged="ImportScenarioJson" Accept=".json">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.UploadFile">불러오기</MudButton>
                            </ActivatorContent>
                        </MudFileUpload>
                    </div>

                    @if (Session.ScenarioSteps.Count == 0)
                    {
                        <div class="wb-empty"><div>등록된 시나리오 단계 없음</div></div>
                    }
                    else
                    {
                        <div class="wb-scroll" style="max-height:320px;">
                            @for (var i = 0; i < Session.ScenarioSteps.Count; i++)
                            {
                                var step = Session.ScenarioSteps[i];
                                <div class="wb-scenario-step mb-2">
                                    <div class="wb-scenario-step-top">
                                        <div>
                                            <div class="wb-scenario-step-order">Step @(i + 1)</div>
                                            <div class="wb-scenario-step-title">@step.TopicName</div>
                                        </div>
                                        <div class="wb-chip-row">
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@step.TypeName</MudChip>
                                            <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" Color="Color.Error"
                                                           OnClick="@(() => RemoveScenarioStep(i))" title="단계 삭제" />
                                        </div>
                                    </div>
                                    <div class="wb-home-form">
                                        <MudSelect T="string" Label="토픽" Value="@step.TopicName"
                                                   ValueChanged="@((string topicName) => OnScenarioStepTopicChanged(step, topicName))"
                                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                                   Class="wb-select wb-select--comfortable wb-select--ellipsis">
                                            @foreach (var t in Session.Topics)
                                            {
                                                <MudSelectItem T="string" Value="@t.TopicName">
                                                    @($"{t.TopicName} · {t.TypeName}")
                                                </MudSelectItem>
                                            }
                                        </MudSelect>
                                        <MudNumericField @bind-Value="step.RepeatCount" Label="반복"
                                                         Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        <MudNumericField @bind-Value="step.DelayAfterMs" Label="이 단계 후 지연(ms)"
                                                         Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    </div>
                                    <MudTextField @bind-Value="step.JsonPayload" Lines="3" Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" Label="JSON" />
                                </div>
                            }
                        </div>
                    }

                    <div class="wb-subpanel mt-3 pa-3">
                        <div class="d-flex align-center mb-2" style="gap:8px;">
                            <div>
                                <div class="wb-panel-kicker">송신 목록</div>
                                <div class="wb-panel-heading">최근 DDS 발행 결과</div>
                            </div>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@RecentOutbound.Count</MudChip>
                        </div>

                        @if (RecentOutbound.Count == 0)
                        {
                            <div class="wb-empty"><div>아직 송신된 DDS 메시지 없음</div></div>
                        }
                        else
                        {
                            <div class="wb-scroll" style="max-height:200px;">
                                @foreach (var o in RecentOutbound)
                                {
                                    <div class="wb-scenario-step mb-2">
                                        <div class="wb-scenario-step-top">
                                            <div class="wb-scenario-step-title">@o.TopicName</div>
                                            <MudChip T="string" Size="Size.Small"
                                                     Color="@(o.Success ? Color.Success : Color.Error)"
                                                     Variant="Variant.Text" Class="ma-0">@(o.Success ? "OK" : "실패")</MudChip>
                                        </div>
                                        <div class="wb-scenario-step-meta">
                                            <div>
                                                <span class="wb-scenario-label">시각</span>
                                                <span class="wb-scenario-value">@o.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                                            </div>
                                            @if (!o.Success)
                                            {
                                                <div>
                                                    <span class="wb-scenario-label">오류</span>
                                                    <span class="wb-scenario-value">@o.Error</span>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
                </div>
            </MudItem>

            <MudItem xs="12">
                <div class="wb-panel wb-panel--major wb-panel--contain pa-3 mb-4">
                    <div class="d-flex align-center mb-2" style="gap:8px;">
                        <MudIcon Icon="@Icons.Material.Filled.Feed" Size="Size.Small" Color="Color.Info" />
                        <div>
                            <div class="wb-panel-kicker">세션 / 시스템 로그</div>
                            <div class="wb-panel-heading">세션 범위 영속 로그</div>
                        </div>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@Session.LogEntries.Count</MudChip>
                        <MudSpacer />
                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.CleaningServices"
                                   OnClick="ClearLogs">로그 비우기</MudButton>
                    </div>

                    @if (Session.LogEntries.Count == 0)
                    {
                        <div class="wb-empty"><div>로그 없음</div></div>
                    }
                    else
                    {
                        <div class="wb-scroll" style="max-height:260px;">
                            @foreach (var entry in Session.LogEntries)
                            {
                                <div class="wb-call-row wb-message-row mb-1">
                                    <div class="wb-message-row-main">
                                        <span class="wb-mono">@entry.TimestampUtc.ToLocalTime().ToString("HH:mm:ss")</span>
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@LogColor(entry.Level)" Variant="Variant.Text" Class="ma-0">@entry.Level</MudChip>
                                        <span class="wb-inline-note">@entry.Scope</span>
                                    </div>
                                    <div style="font-size:.8rem;">@entry.Message</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </MudItem>
        </MudGrid>
}

@code {
    [Parameter] public DdsSession? Session { get; set; }

    private string _subscriptionTopicName = "";
    private DdsTopicConfig? _subscriptionTopic;
    private long _selectedSampleSeq = 0;

    private string _scenarioDraftTopicName = "";
    private DdsTopicConfig? _scenarioDraftTopic;
    private string _scenarioDraftJson = "{}";
    private bool _scenarioDraftRawJsonMode;
    private List<SchemaField> _scenarioDraftSchemaFields = [];

    private bool _showTypesXml;
    private bool _showConfigXml;

    private bool _runningScenario;
    private CancellationTokenSource? _scenarioCts;

    private const int MaxLogEntries = 500;

    private DdsSubscriptionInfo? CurrentSubscription
        => Session == null || _subscriptionTopic == null
            ? null
            : DdsState.SnapshotSubscriptions(Session.SessionId).FirstOrDefault(s => s.TopicName == _subscriptionTopic.TopicName);

    private bool CanSubscribeCurrentTopic
        => _subscriptionTopic != null && _subscriptionTopic.Direction != DdsTopicDirection.Publish;

    private bool CanPublishScenarioDraft
        => _scenarioDraftTopic != null && _scenarioDraftTopic.Direction != DdsTopicDirection.Subscribe;

    private IReadOnlyList<DdsOutboundEntry> RecentOutbound
        => Session == null ? [] : DdsState.SnapshotOutbound(Session.SessionId, 10);

    protected override void OnInitialized()
    {
        DdsState.StateChanged += OnDdsStateChanged;
        DdsState.SampleReceived += OnSampleReceived;
    }

    protected override void OnParametersSet()
    {
        if (Session == null) return;

        if (_subscriptionTopic == null && Session.Topics.Count > 0)
        {
            _subscriptionTopicName = Session.Topics[0].TopicName;
            _subscriptionTopic = Session.Topics[0];
        }
        if (_scenarioDraftTopic == null && Session.Topics.Count > 0)
        {
            var publishable = Session.Topics.FirstOrDefault(t => t.Direction != DdsTopicDirection.Subscribe) ?? Session.Topics[0];
            _scenarioDraftTopicName = publishable.TopicName;
            _scenarioDraftTopic = publishable;
        }
        BuildScenarioDraftSchemaForTopic();

        Session.ScenarioOptions.CycleCount = Math.Max(1, Session.ScenarioOptions.CycleCount);
        Session.ScenarioOptions.DefaultStepDelayMs = Math.Max(0, Session.ScenarioOptions.DefaultStepDelayMs);
    }

    private void BuildScenarioDraftSchemaForTopic()
    {
        if (Session == null || _scenarioDraftTopic == null)
        {
            _scenarioDraftSchemaFields = [];
            _scenarioDraftJson = "{}";
            return;
        }

        if (!Session.Types.TryGetValue(_scenarioDraftTopic.TypeName, out var typeDef) || typeDef.Kind != DdsTypeKind.Struct)
        {
            _scenarioDraftSchemaFields = [];
            _scenarioDraftJson = "{}";
            return;
        }

        var next = new List<SchemaField>();
        foreach (var member in typeDef.Members)
        {
            next.Add(BuildSchemaField(member));
        }

        _scenarioDraftSchemaFields = next;
        _scenarioDraftRawJsonMode = false;
        BuildScenarioDraftJsonFromForm();
    }

    private SchemaField BuildSchemaField(DdsTypeMember member)
    {
        if (member.IsArray || member.IsSequence)
        {
            return new SchemaField
            {
                Name = member.Name,
                Type = "array",
                Value = "[]",
                ItemTemplate = BuildArrayItemTemplate(member),
            };
        }

        if (Session != null && Session.Types.TryGetValue(member.TypeName, out var nestedType))
        {
            if (nestedType.Kind == DdsTypeKind.Enum)
            {
                return new SchemaField
                {
                    Name = member.Name,
                    Type = "enum",
                    EnumValues = nestedType.EnumValues.Keys.ToArray(),
                    Value = nestedType.EnumValues.Keys.FirstOrDefault() ?? string.Empty,
                };
            }

            if (nestedType.Kind == DdsTypeKind.Struct)
            {
                return new SchemaField
                {
                    Name = member.Name,
                    Type = "object",
                    Value = "{}",
                    Children = nestedType.Members.Select(BuildSchemaField).ToList(),
                };
            }
        }

        return new SchemaField
        {
            Name = member.Name,
            Type = MapPrimitiveType(member.TypeName),
            Value = DefaultValueForPrimitive(member.TypeName),
            BoolValue = false,
        };
    }

    private SchemaField BuildArrayItemTemplate(DdsTypeMember member)
    {
        if (Session != null && Session.Types.TryGetValue(member.TypeName, out var nestedType))
        {
            if (nestedType.Kind == DdsTypeKind.Struct)
            {
                return new SchemaField
                {
                    Name = "0",
                    Type = "object",
                    Value = "{}",
                    Children = nestedType.Members.Select(BuildSchemaField).ToList(),
                };
            }

            if (nestedType.Kind == DdsTypeKind.Enum)
            {
                return new SchemaField
                {
                    Name = "0",
                    Type = "enum",
                    EnumValues = nestedType.EnumValues.Keys.ToArray(),
                    Value = nestedType.EnumValues.Keys.FirstOrDefault() ?? string.Empty,
                };
            }
        }

        return new SchemaField
        {
            Name = "0",
            Type = MapPrimitiveType(member.TypeName),
            Value = DefaultValueForPrimitive(member.TypeName),
        };
    }

    private static string MapPrimitiveType(string typeName)
    {
        var normalized = typeName.ToLowerInvariant();
        return normalized switch
        {
            "boolean" or "bool" => "boolean",
            "int8" or "int16" or "int32" or "int64" or "uint8" or "uint16" or "uint32" or "uint64" or "long" or "ulong" or "short" or "ushort" => "integer",
            "float" or "float32" or "float64" or "double" => "number",
            _ => "string",
        };
    }

    private static string DefaultValueForPrimitive(string typeName)
    {
        var primitive = MapPrimitiveType(typeName);
        return primitive switch
        {
            "integer" or "number" => "0",
            _ => string.Empty,
        };
    }

    private void OnScenarioDraftRawModeChanged(bool raw)
    {
        _scenarioDraftRawJsonMode = raw;
        if (_scenarioDraftSchemaFields.Count == 0)
            return;

        if (raw)
            BuildScenarioDraftJsonFromForm();
        else
            TryPopulatePublishFieldsFromJson(_scenarioDraftJson);
    }

    private void BuildScenarioDraftJsonFromForm()
    {
        _scenarioDraftJson = JsonSerializer.Serialize(
            BuildJsonObject(_scenarioDraftSchemaFields),
            new JsonSerializerOptions { WriteIndented = true });
    }

    private static Dictionary<string, object?> BuildJsonObject(List<SchemaField> fields)
    {
        var obj = new Dictionary<string, object?>();
        foreach (var field in fields)
            obj[field.Name] = BuildFieldValue(field);
        return obj;
    }

    private static object? BuildFieldValue(SchemaField field) => field.Type switch
    {
        "boolean" => field.BoolValue,
        "integer" => long.TryParse(field.Value, out var longValue) ? longValue : 0L,
        "number" => double.TryParse(field.Value, System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var doubleValue) ? doubleValue : 0.0,
        "object" when field.Children.Count > 0 => BuildJsonObject(field.Children),
        "object" => TryParseRaw(field.Value),
        "array" when field.ItemTemplate != null => field.ArrayItems.Select(BuildFieldValue).ToArray(),
        "array" => TryParseRaw(field.Value),
        _ => (object?)field.Value
    };

    private static object? TryParseRaw(string value)
    {
        try
        {
            using var doc = JsonDocument.Parse(value);
            return doc.RootElement.Clone();
        }
        catch
        {
            return value;
        }
    }

    private void TryPopulatePublishFieldsFromJson(string? json)
    {
        if (_scenarioDraftSchemaFields.Count == 0 || string.IsNullOrWhiteSpace(json)) return;

        try
        {
            using var doc = JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind != JsonValueKind.Object)
                return;

            ApplyObjectToFields(_scenarioDraftSchemaFields, doc.RootElement);
        }
        catch
        {
        }
    }

    private static void ApplyObjectToFields(List<SchemaField> fields, JsonElement element)
    {
        foreach (var field in fields)
        {
            if (!element.TryGetProperty(field.Name, out var value))
                continue;
            ApplyJsonToField(field, value);
        }
    }

    private static void ApplyJsonToField(SchemaField field, JsonElement value)
    {
        switch (field.Type)
        {
            case "boolean":
                field.BoolValue = value.ValueKind == JsonValueKind.True || (value.ValueKind == JsonValueKind.False ? false : field.BoolValue);
                break;
            case "integer":
            case "number":
            case "string":
            case "enum":
                field.Value = value.ValueKind == JsonValueKind.String ? value.GetString() ?? string.Empty : value.ToString();
                break;
            case "object":
                if (field.Children.Count > 0 && value.ValueKind == JsonValueKind.Object)
                    ApplyObjectToFields(field.Children, value);
                else
                    field.Value = value.GetRawText();
                break;
            case "array":
                if (field.ItemTemplate != null && value.ValueKind == JsonValueKind.Array)
                {
                    field.ArrayItems.Clear();
                    var index = 0;
                    foreach (var item in value.EnumerateArray())
                    {
                        var clone = field.ItemTemplate.DeepClone(index.ToString());
                        ApplyJsonToField(clone, item);
                        field.ArrayItems.Add(clone);
                        index++;
                    }
                }
                else
                {
                    field.Value = value.GetRawText();
                }
                break;
            default:
                field.Value = value.ToString();
                break;
        }
    }

    private void OnSubscriptionTopicChanged(string topicName)
    {
        _subscriptionTopicName = topicName;
        _subscriptionTopic = Session?.Topics.FirstOrDefault(t => t.TopicName == topicName);
        _selectedSampleSeq = 0;
    }

    private void OnScenarioDraftTopicChanged(string topicName)
    {
        _scenarioDraftTopicName = topicName;
        _scenarioDraftTopic = Session?.Topics.FirstOrDefault(t => t.TopicName == topicName);
        BuildScenarioDraftSchemaForTopic();
    }

    private void StartSubscribe()
    {
        if (Session == null || _subscriptionTopic == null) return;
        try
        {
            DdsState.StartSubscription(
                Session.SessionId, _subscriptionTopic.TopicName, _subscriptionTopic.TypeName, _subscriptionTopic.QosProfileName);
            Snackbar.Add($"구독 시작: {_subscriptionTopic.TopicName}", Severity.Success);
            AppendLog("session", "INFO", $"구독 시작: {_subscriptionTopic.TopicName}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"구독 실패: {ex.Message}", Severity.Error);
            AppendLog("system", "ERROR", $"구독 실패: {ex.Message}");
        }
    }

    private void StopSubscribe(string subId)
    {
        DdsState.StopSubscription(subId);
        _selectedSampleSeq = 0;
        AppendLog("session", "INFO", $"구독 중지: {subId[..Math.Min(8, subId.Length)]}");
    }

    private void LoadScenarioDraftTemplate()
    {
        if (Session == null || _scenarioDraftTopic == null) return;
        try
        {
            var host = DdsSessions.GetHost(Session.SessionId);
            if (host == null) return;
            using var sample = host.CreateSample(_scenarioDraftTopic.TypeName);
            _scenarioDraftJson = DdsJsonConverter.ToJson(sample, pretty: true);
            TryPopulatePublishFieldsFromJson(_scenarioDraftJson);
            BuildScenarioDraftJsonFromForm();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"템플릿 생성 실패: {ex.Message}", Severity.Warning);
            AppendLog("system", "WARN", $"템플릿 생성 실패: {ex.Message}");
        }
    }

    private void AddScenarioStep()
    {
        if (Session == null || _scenarioDraftTopic == null) return;
        if (_scenarioDraftTopic.Direction == DdsTopicDirection.Subscribe)
        {
            Snackbar.Add("Subscribe 전용 토픽은 시나리오 발행 단계로 추가할 수 없습니다.", Severity.Warning);
            return;
        }
        if (!_scenarioDraftRawJsonMode && _scenarioDraftSchemaFields.Count > 0)
            BuildScenarioDraftJsonFromForm();

        Session.ScenarioSteps.Add(new DdsScenarioStep
        {
            TopicName = _scenarioDraftTopic.TopicName,
            TypeName = _scenarioDraftTopic.TypeName,
            QosProfileName = _scenarioDraftTopic.QosProfileName,
            JsonPayload = _scenarioDraftJson,
            RepeatCount = 1,
            DelayAfterMs = 0,
        });
        AppendLog("session", "INFO", $"시나리오 단계 추가: {_scenarioDraftTopic.TopicName}");
    }

    private void OnScenarioStepTopicChanged(DdsScenarioStep step, string topicName)
    {
        if (Session == null) return;

        step.TopicName = topicName;
        var topic = Session.Topics.FirstOrDefault(t => t.TopicName == topicName);
        if (topic == null) return;

        step.TypeName = topic.TypeName;
        step.QosProfileName = topic.QosProfileName;
    }

    private void RemoveScenarioStep(int index)
    {
        if (Session == null) return;
        if (index < 0 || index >= Session.ScenarioSteps.Count) return;
        var removed = Session.ScenarioSteps[index];
        Session.ScenarioSteps.RemoveAt(index);
        AppendLog("session", "INFO", $"시나리오 단계 삭제: {removed.TopicName}");
    }

    private async Task RunScenario()
    {
        if (Session == null || Session.ScenarioSteps.Count == 0 || _runningScenario) return;

        _runningScenario = true;
        _scenarioCts = new CancellationTokenSource();
        var ct = _scenarioCts.Token;
        var options = Session.ScenarioOptions;

        AppendLog("session", "INFO", $"시나리오 실행 시작: {Session.ScenarioSteps.Count} step, cycle {options.CycleCount}");

        try
        {
            for (var cycle = 1; cycle <= Math.Max(1, options.CycleCount); cycle++)
            {
                for (var i = 0; i < Session.ScenarioSteps.Count; i++)
                {
                    ct.ThrowIfCancellationRequested();
                    var step = Session.ScenarioSteps[i];

                    for (var repeat = 1; repeat <= Math.Max(1, step.RepeatCount); repeat++)
                    {
                        ct.ThrowIfCancellationRequested();
                        var result = await Task.Run(() => DdsState.Publish(
                            Session.SessionId,
                            step.TopicName,
                            step.TypeName,
                            step.QosProfileName,
                            step.JsonPayload), ct);

                        if (!result.Success)
                        {
                            AppendLog("system", "ERROR", $"cycle {cycle} step {i + 1}/{Session.ScenarioSteps.Count} 실패: {result.Error}");
                            if (options.StopOnError)
                            {
                                AppendLog("system", "WARN", "오류 발생으로 시나리오 중단");
                                return;
                            }
                        }
                        else
                        {
                            AppendLog("session", "INFO", $"cycle {cycle} step {i + 1}/{Session.ScenarioSteps.Count} repeat {repeat}/{Math.Max(1, step.RepeatCount)} 성공");
                        }
                    }

                    var delayMs = step.DelayAfterMs > 0 ? step.DelayAfterMs : Math.Max(0, options.DefaultStepDelayMs);
                    if (delayMs > 0)
                        await Task.Delay(delayMs, ct);
                }
            }

            Snackbar.Add("DDS 시나리오 실행 완료", Severity.Success);
            AppendLog("session", "INFO", "시나리오 실행 완료");
        }
        catch (OperationCanceledException)
        {
            Snackbar.Add("DDS 시나리오 실행 중단", Severity.Warning);
            AppendLog("system", "WARN", "사용자 요청으로 시나리오 중단");
        }
        finally
        {
            _runningScenario = false;
            _scenarioCts?.Dispose();
            _scenarioCts = null;
        }
    }

    private void StopScenario()
    {
        _scenarioCts?.Cancel();
    }

    private async Task ExportScenarioJson()
    {
        if (Session == null || Session.ScenarioSteps.Count == 0)
        {
            Snackbar.Add("저장할 시나리오 단계가 없습니다.", Severity.Warning);
            return;
        }

        var payload = new DdsScenarioExportFile
        {
            Version = 1,
            ExportedAt = DateTimeOffset.Now,
            Options = Session.ScenarioOptions,
            Steps = Session.ScenarioSteps.ToList(),
        };

        var json = JsonSerializer.Serialize(payload, new JsonSerializerOptions { WriteIndented = true });
        await JS.InvokeVoidAsync("workbench.downloadText", $"dds-scenario-{SanitizeFileName(Session.Name)}.json", json, "application/json");
        Snackbar.Add($"DDS 시나리오 저장 완료: {Session.ScenarioSteps.Count} step", Severity.Success);
        AppendLog("session", "INFO", $"시나리오 저장: {Session.ScenarioSteps.Count} step");
    }

    private async Task ImportScenarioJson(IBrowserFile? file)
    {
        if (Session == null || file == null) return;

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            var payload = JsonSerializer.Deserialize<DdsScenarioExportFile>(json);

            if (payload?.Steps == null || payload.Steps.Count == 0)
            {
                Snackbar.Add("불러올 DDS 시나리오 step이 없습니다.", Severity.Warning);
                return;
            }

            Session.ScenarioSteps = payload.Steps
                .Where(step => !string.IsNullOrWhiteSpace(step.TopicName) && !string.IsNullOrWhiteSpace(step.TypeName))
                .Select(step => new DdsScenarioStep
                {
                    TopicName = step.TopicName,
                    TypeName = step.TypeName,
                    QosProfileName = step.QosProfileName,
                    JsonPayload = string.IsNullOrWhiteSpace(step.JsonPayload) ? "{}" : step.JsonPayload,
                    RepeatCount = Math.Max(1, step.RepeatCount),
                    DelayAfterMs = Math.Max(0, step.DelayAfterMs),
                })
                .ToList();

            Session.ScenarioOptions = payload.Options ?? new DdsScenarioRunOptions();
            Session.ScenarioOptions.CycleCount = Math.Max(1, Session.ScenarioOptions.CycleCount);
            Session.ScenarioOptions.DefaultStepDelayMs = Math.Max(0, Session.ScenarioOptions.DefaultStepDelayMs);

            Snackbar.Add($"DDS 시나리오 불러오기 완료: {Session.ScenarioSteps.Count} step", Severity.Success);
            AppendLog("session", "INFO", $"시나리오 불러오기: {Session.ScenarioSteps.Count} step");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"DDS 시나리오 불러오기 실패: {ex.Message}", Severity.Error);
            AppendLog("system", "ERROR", $"시나리오 불러오기 실패: {ex.Message}");
        }
    }

    private void ClearLogs()
    {
        Session?.LogEntries.Clear();
    }

    private void OnSampleReceived(DdsSubscriptionInfo info, DdsSampleEntry sample)
    {
        if (Session == null || info.SessionId != Session.SessionId) return;
        AppendLog("session", "INFO", $"수신: {info.TopicName} #{sample.SequenceNumber}");
    }

    private async void OnDdsStateChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private void AppendLog(string scope, string level, string message)
    {
        if (Session == null) return;

        Session.LogEntries.Insert(0, new DdsSessionLogEntry
        {
            TimestampUtc = DateTime.UtcNow,
            Scope = scope,
            Level = level,
            Message = message,
        });

        if (Session.LogEntries.Count > MaxLogEntries)
        {
            Session.LogEntries.RemoveRange(MaxLogEntries, Session.LogEntries.Count - MaxLogEntries);
        }
    }

    private static Color LogColor(string level) => level switch
    {
        "ERROR" => Color.Error,
        "WARN" => Color.Warning,
        _ => Color.Default,
    };

    private string GetTypesXmlText()
    {
        if (Session?.TypesXmlContent == null) return string.Empty;
        return System.Text.Encoding.UTF8.GetString(Session.TypesXmlContent);
    }

    private string GetConfigXmlText()
    {
        if (Session?.ConfigXmlContent == null) return string.Empty;
        return System.Text.Encoding.UTF8.GetString(Session.ConfigXmlContent);
    }

    private async Task DownloadTypesXml()
    {
        if (Session?.TypesXmlContent == null) return;
        var fileName = string.IsNullOrWhiteSpace(Session.TypesXmlFileName)
            ? "DDSSim.xml"
            : Session.TypesXmlFileName;
        await JS.InvokeVoidAsync("workbench.downloadText", fileName, GetTypesXmlText(), "application/xml");
    }

    private async Task DownloadConfigXml()
    {
        if (Session?.ConfigXmlContent == null) return;
        var fileName = string.IsNullOrWhiteSpace(Session.ConfigXmlFileName)
            ? "dds-config.xml"
            : Session.ConfigXmlFileName;
        await JS.InvokeVoidAsync("workbench.downloadText", fileName, GetConfigXmlText(), "application/xml");
    }

    public void Dispose()
    {
        DdsState.StateChanged -= OnDdsStateChanged;
        DdsState.SampleReceived -= OnSampleReceived;
        _scenarioCts?.Cancel();
        _scenarioCts?.Dispose();
    }

    private string? FindGrpcMatch(string topicName)
    {
        foreach (var svc in GrpcState.Services)
        {
            var m = svc.Methods.FirstOrDefault(x =>
                string.Equals(x.MethodName, topicName, StringComparison.Ordinal) ||
                string.Equals(x.MethodName, "Stream" + topicName, StringComparison.Ordinal));
            if (m != null)
                return $"{svc.ServiceName.Split('.').Last()}.{m.MethodName}";
        }
        return null;
    }

    private static string SanitizeFileName(string value)
    {
        var invalid = Path.GetInvalidFileNameChars();
        var cleaned = new string(value.Select(ch => invalid.Contains(ch) ? '-' : ch).ToArray()).Trim();
        return string.IsNullOrWhiteSpace(cleaned) ? "dds-scenario" : cleaned;
    }

    private sealed class DdsScenarioExportFile
    {
        public int Version { get; set; }
        public DateTimeOffset ExportedAt { get; set; }
        public DdsScenarioRunOptions? Options { get; set; }
        public List<DdsScenarioStep> Steps { get; set; } = [];
    }

}
