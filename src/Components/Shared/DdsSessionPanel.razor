@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using GrpcWorkbench.Models.Dds
@using GrpcWorkbench.Models.Session
@using GrpcWorkbench.Models.Ui
@using GrpcWorkbench.Services
@using GrpcWorkbench.Dds
@inject IDdsSessionService DdsSessions
@inject DdsStateService DdsState
@inject DdsTriggerService Triggers
@inject WorkbenchStateService GrpcState
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@implements IDisposable

@if (Session == null)
{
    <div class="wb-empty"><div>DDS 세션이 선택되지 않았습니다</div></div>
}
else
{
    <div class="wb-panel wb-panel--major wb-panel--contain pa-3 mb-4">
        <div class="d-flex align-center flex-wrap mb-2" style="gap:8px;">
            <MudIcon Icon="@Icons.Material.Filled.Cable" Size="Size.Small" Color="Color.Success" />
            <div>
                <div class="wb-panel-kicker">DDS 세션</div>
                <div class="wb-panel-heading">@Session.Name · domain @Session.Transport.DomainId</div>
            </div>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@Session.Topics.Count 토픽</MudChip>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@Session.Types.Count 타입</MudChip>
            @if (Session.QosProfiles.Count > 0)
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">QoS: @string.Join(",", Session.QosProfiles)</MudChip>
            }
        </div>

        <div class="wb-subpanel mb-3 pa-3">
            <div class="wb-panel-kicker">기본 정보</div>
            <div class="wb-home-form mt-2">
                <div class="wb-code" style="font-size:.74rem;">
                    <span style="color:var(--mud-palette-text-secondary);">세션 ID</span><br />
                    <span class="wb-mono">@Session.SessionId</span>
                </div>
                <div class="wb-code" style="font-size:.74rem;">
                    <span style="color:var(--mud-palette-text-secondary);">생성 시각</span><br />
                    @Session.CreatedAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                </div>
                <div class="wb-code" style="font-size:.74rem;">
                    <span style="color:var(--mud-palette-text-secondary);">Domain ID</span><br />
                    @Session.Transport.DomainId
                </div>
                <div class="wb-code" style="font-size:.74rem;">
                    <span style="color:var(--mud-palette-text-secondary);">멀티캐스트</span><br />
                    @(string.IsNullOrWhiteSpace(Session.Transport.MulticastAddress) ? "(미설정)" : Session.Transport.MulticastAddress)
                </div>
                <div class="wb-code" style="font-size:.74rem;">
                    <span style="color:var(--mud-palette-text-secondary);">송신/수신 버퍼</span><br />
                    @(Session.Transport.SendBufferSize?.ToString() ?? "default") / @(Session.Transport.ReceiveBufferSize?.ToString() ?? "default")
                </div>
                <div class="wb-code" style="font-size:.74rem;">
                    <span style="color:var(--mud-palette-text-secondary);">업로드 XML</span><br />
                    @(string.IsNullOrWhiteSpace(Session.TypesXmlFileName) ? "types.xml 미기록" : Session.TypesXmlFileName) ·
                    @(string.IsNullOrWhiteSpace(Session.ConfigXmlFileName) ? "dds-config.xml 미기록" : Session.ConfigXmlFileName)
                </div>
            </div>

            <div class="mt-3">
                <div class="d-flex align-center" style="gap:8px;">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">
                        DDSSim XML @(Session.TypesXmlContent?.Length ?? 0) bytes
                    </MudChip>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Visibility"
                               OnClick="@(() => _showTypesXml = !_showTypesXml)">
                        @(_showTypesXml ? "숨기기" : "내용 보기")
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Download"
                               OnClick="DownloadTypesXml"
                               Disabled="@(Session.TypesXmlContent == null)">
                        저장
                    </MudButton>
                </div>
                @if (_showTypesXml)
                {
                    <MudTextField Value="@GetTypesXmlText()" ReadOnly="true" Lines="8"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Label="DDSSim XML" />
                }
            </div>

            <div class="mt-2">
                <div class="d-flex align-center" style="gap:8px;">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">
                        dds-config XML @(Session.ConfigXmlContent?.Length ?? 0) bytes
                    </MudChip>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Visibility"
                               OnClick="@(() => _showConfigXml = !_showConfigXml)">
                        @(_showConfigXml ? "숨기기" : "내용 보기")
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Download"
                               OnClick="DownloadConfigXml"
                               Disabled="@(Session.ConfigXmlContent == null)">
                        저장
                    </MudButton>
                </div>
                @if (_showConfigXml)
                {
                    <MudTextField Value="@GetConfigXmlText()" ReadOnly="true" Lines="8"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Label="dds-config XML" />
                }
            </div>
        </div>

    </div>
    <MudGrid Spacing="2">
            <MudItem xs="12" md="6">
                <div class="wb-panel wb-panel--major wb-panel--contain pa-3">
                    <div class="d-flex align-center mb-2" style="gap:8px;">
                        <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Small" Color="Color.Info" />
                        <div>
                            <div class="wb-panel-kicker">수신</div>
                            <div class="wb-panel-heading">수신 토픽과 샘플</div>
                        </div>
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Class="ma-0">@ActiveSubscriptions.Count 활성</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@SelectedReceivableTopicCount 선택</MudChip>
                        <MudSpacer />
                    </div>

                    @if (ReceivableTopics.Count == 0)
                    {
                        <div class="wb-empty"><div>수신 가능한 DDS 토픽이 없습니다</div></div>
                    }
                    else
                    {
                        <div class="wb-subpanel mb-3 pa-3">
                            <div class="d-flex align-center mb-2" style="gap:8px;">
                                <div>
                                    <div class="wb-panel-kicker">수신 토픽 선택</div>
                                    <div class="wb-panel-heading">팝업에서 수신 토픽을 선택하고 한 번에 시작/중지</div>
                                </div>
                                <MudSpacer />
                                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Checklist"
                                           OnClick="OpenReceiveTopicPicker">수신 토픽 선택</MudButton>
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.PlayArrow"
                                           Disabled="@(SelectedStartableSubscriptionCount == 0)"
                                           OnClick="StartSelectedSubscriptions">수신 시작</MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Stop"
                                           Disabled="@(SelectedActiveSubscriptionCount == 0)"
                                           OnClick="StopSelectedSubscriptions">선택 중지</MudButton>
                            </div>

                            <div class="d-flex flex-wrap" style="gap:8px;">
                                @if (SelectedReceivableTopicCount == 0)
                                {
                                    <div class="wb-inline-note">선택된 수신 토픽이 없습니다. "수신 토픽 선택" 버튼을 눌러 고르세요.</div>
                                }
                                else
                                {
                                    @foreach (var topicName in SelectedReceivableTopicNames)
                                    {
                                        var selectedTopic = FindTopic(topicName);
                                        var isActive = ActiveSubscriptions.Any(s => s.TopicName == topicName);
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@(isActive ? Color.Success : Color.Default)"
                                                 Variant="Variant.Outlined"
                                                 OnClose="@(() => RemoveSelectedSubscriptionTopic(topicName))">
                                            @topicName@if (selectedTopic != null) { <text> · @selectedTopic.TypeName</text> }
                                        </MudChip>
                                    }
                                }
                            </div>
                        </div>

                        @if (ActiveSubscriptions.Count == 0)
                        {
                            <div class="wb-empty"><div>수신 중인 토픽이 없습니다</div></div>
                        }
                        else
                        {
                            var selectedSubscription = SelectedSubscription;
                            var selectedTopic = selectedSubscription == null ? null : FindTopic(selectedSubscription.TopicName);
                            var samples = selectedSubscription == null ? [] : DdsState.SnapshotSamples(selectedSubscription.SubscriptionId, 50);
                            <div class="wb-message-split">
                                <div class="wb-scroll wb-message-list">
                                    @foreach (var subscription in ActiveSubscriptions)
                                    {
                                        <button type="button"
                                                class="wb-call-row @(selectedSubscription?.SubscriptionId == subscription.SubscriptionId ? "is-selected" : null)"
                                                @onclick="@(() => SelectSubscription(subscription.SubscriptionId))">
                                            <div class="wb-call-row-top">
                                                <span class="wb-mono wb-call-row-title">@subscription.TopicName</span>
                                                <span class="wb-call-row-count">@subscription.ReceivedCount 개 수신</span>
                                            </div>
                                            <div class="wb-call-row-meta">
                                                <span>@subscription.TypeName</span>
                                                <span>@subscription.StartedAt.ToLocalTime().ToString("HH:mm:ss")</span>
                                            </div>
                                        </button>
                                    }
                                </div>
                                <div class="wb-message-content">
                                    @if (selectedSubscription == null)
                                    {
                                        <div class="wb-empty"><div>왼쪽에서 수신 토픽을 선택하세요</div></div>
                                    }
                                    else if (samples.Count == 0)
                                    {
                                        <div class="wb-inline-note mb-2">@($"type: {selectedTopic?.TypeName ?? selectedSubscription.TypeName} · qos: {selectedTopic?.QosProfileName ?? "(미확인)"}")</div>
                                        <div class="wb-empty"><div>아직 수신된 샘플 없음</div></div>
                                    }
                                    else
                                    {
                                        <div class="wb-inline-note mb-2">@($"type: {selectedTopic?.TypeName ?? selectedSubscription.TypeName} · qos: {selectedTopic?.QosProfileName ?? "(미확인)"}")</div>
                                        var sel = samples.FirstOrDefault(x => x.SequenceNumber == _selectedSampleSeq) ?? samples.First();
                                        <div class="wb-message-split">
                                            <div class="wb-scroll wb-message-list">
                                                @foreach (var sample in samples)
                                                {
                                                    <button type="button"
                                                            class="wb-call-row wb-message-row @(sel.SequenceNumber == sample.SequenceNumber ? "is-selected" : null)"
                                                            @onclick="@(() => _selectedSampleSeq = sample.SequenceNumber)">
                                                        <div class="wb-message-row-main">
                                                            <span class="wb-mono">@sample.ReceivedAt.ToLocalTime().ToString("HH:mm:ss")</span>
                                                            <span>#@sample.SequenceNumber</span>
                                                        </div>
                                                    </button>
                                                }
                                            </div>
                                            <div class="wb-message-content">
                                                <JsonDataView Json="@sel.JsonData" />
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    }
                </div>
            </MudItem>

            <MudItem xs="12" md="6">
                <div class="wb-panel wb-panel--major wb-panel--contain pa-3">
                    <div class="d-flex align-center mb-2" style="gap:8px;">
                        <MudIcon Icon="@Icons.Material.Filled.NorthEast" Size="Size.Small" Color="Color.Primary" />
                        <div>
                            <div class="wb-panel-kicker">송신</div>
                            <div class="wb-panel-heading">최근 DDS 송신 결과</div>
                        </div>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@RecentOutbound.Count</MudChip>
                    </div>

                    @if (RecentOutbound.Count == 0)
                    {
                        <div class="wb-empty"><div>아직 송신된 DDS 메시지 없음</div></div>
                    }
                    else
                    {
                        <div class="wb-scroll" style="max-height:420px;">
                            @foreach (var o in RecentOutbound)
                            {
                                <div class="wb-scenario-step mb-2">
                                    <div class="wb-scenario-step-top">
                                        <div class="wb-scenario-step-title">@o.TopicName</div>
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@(o.Success ? Color.Success : Color.Error)"
                                                 Variant="Variant.Text" Class="ma-0">@(o.Success ? "OK" : "실패")</MudChip>
                                    </div>
                                    <div class="wb-scenario-step-meta">
                                        <div>
                                            <span class="wb-scenario-label">시각</span>
                                            <span class="wb-scenario-value">@o.Timestamp.ToLocalTime().ToString("HH:mm:ss")</span>
                                        </div>
                                        <div>
                                            <span class="wb-scenario-label">타입</span>
                                            <span class="wb-scenario-value">@o.TypeName</span>
                                        </div>
                                        @if (!o.Success)
                                        {
                                            <div>
                                                <span class="wb-scenario-label">오류</span>
                                                <span class="wb-scenario-value">@o.Error</span>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </MudItem>

            <MudItem xs="12">
                <div class="wb-panel wb-panel--major wb-panel--contain pa-3">
                    <div class="d-flex align-center mb-2" style="gap:8px;">
                        <MudIcon Icon="@Icons.Material.Filled.AutoMode" Size="Size.Small" Color="Color.Primary" />
                        <div>
                            <div class="wb-panel-kicker">DDS 자동화</div>
                            <div class="wb-panel-heading">메시지 단계 하나에 수동 실행과 자동 조건을 함께 정의</div>
                        </div>
                    </div>

                    <div class="wb-subpanel pa-3">
                        <div class="d-flex align-center mb-2" style="gap:8px;">
                            <MudIcon Icon="@Icons.Material.Filled.PlaylistPlay" Size="Size.Small" Color="Color.Secondary" />
                            <div>
                                <div class="wb-panel-kicker">자동화 단계</div>
                                <div class="wb-panel-heading">토픽, 메시지, 페이로드, 자동 조건을 한 단계로 편집</div>
                            </div>
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@Session.ScenarioSteps.Count 단계</MudChip>
                            <MudSpacer />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="AddScenarioStep"
                                       Disabled="@(DefaultPublishTopic == null)">단계 추가</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.PlayArrow"
                                   OnClick="RunScenario"
                                   Disabled="@(ManualScenarioStepCount == 0 || _runningScenario)">
                            수동 실행
                        </MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.AutoMode"
                                   OnClick="StartAutomation"
                                   Disabled="@(AutomaticScenarioStepCount == 0 || _automationRunning)">
                            자동화 시작
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Stop"
                                   OnClick="StopAutomation"
                                   Disabled="@(!_automationRunning)">
                            자동화 중지
                        </MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Cancel"
                                   OnClick="StopScenario"
                                   Disabled="@(!_runningScenario)">
                            중단
                        </MudButton>
                    </div>

                    <div class="wb-inline-note mb-2">단계 추가를 누르면 새 스텝이 생성됩니다. 수동 단계는 `수동 실행`으로만 보내고, 주기/다발/수신 반응 단계는 `자동화 시작`을 눌렀을 때만 동작합니다.</div>

                    <div class="wb-home-form mb-2">
                        <MudNumericField @bind-Value="Session.ScenarioOptions.CycleCount" Label="전체 실행 반복 횟수"
                                         Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        <MudCheckBox @bind-Value="Session.ScenarioOptions.StopOnError" Label="오류 시 즉시 중단" Color="Color.Warning" />
                    </div>

                    <div class="d-flex align-center mb-2" style="gap:8px;">
                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Download"
                                   OnClick="ExportScenarioJson"
                                   Disabled="@(Session.ScenarioSteps.Count == 0)">저장</MudButton>
                        <MudFileUpload T="IBrowserFile" FilesChanged="ImportScenarioJson" Accept=".json">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.UploadFile">불러오기</MudButton>
                            </ActivatorContent>
                        </MudFileUpload>
                    </div>

                    @if (Session.ScenarioSteps.Count == 0)
                    {
                        <div class="wb-empty"><div>등록된 메시지 단계 없음</div></div>
                    }
                    else
                    {
                        <div class="wb-scroll" style="max-height:320px;">
                            @for (var i = 0; i < Session.ScenarioSteps.Count; i++)
                            {
                                var stepIndex = i;
                                var step = Session.ScenarioSteps[i];
                                <div class="wb-scenario-step mb-2">
                                    <div class="wb-scenario-step-top">
                                        <div>
                                            <div class="wb-scenario-step-order">Step @(stepIndex + 1)</div>
                                            <div class="wb-scenario-step-title">@(string.IsNullOrWhiteSpace(step.Name) ? step.TopicName : step.Name)</div>
                                        </div>
                                        <div class="wb-chip-row">
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@StepModeLabel(step.Mode)</MudChip>
                                            @if (step.Mode != DdsStepMode.Manual)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="@(_automationRunning ? Color.Success : Color.Default)" Variant="Variant.Text" Class="ma-0">@(_automationRunning ? "자동화 동작 중" : "자동화 대기")</MudChip>
                                            }
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@step.TypeName</MudChip>
                                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Error"
                                                       StartIcon="@Icons.Material.Filled.DeleteOutline"
                                                       OnClick="@(() => RemoveScenarioStep(stepIndex))">삭제</MudButton>
                                        </div>
                                    </div>
                                    <div class="wb-home-form">
                                        <MudTextField @bind-Value="step.Name" Label="이름"
                                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        <MudSelect T="string" Label="토픽" Value="@step.TopicName"
                                                   ValueChanged="@((string topicName) => OnScenarioStepTopicChanged(step, topicName))"
                                                   Variant="Variant.Outlined" Margin="Margin.Dense"
                                                   Class="wb-select wb-select--comfortable wb-select--ellipsis">
                                            @foreach (var t in Session.Topics)
                                            {
                                                <MudSelectItem T="string" Value="@t.TopicName">
                                                    @($"{t.TopicName} · {t.TypeName}")
                                                </MudSelectItem>
                                            }
                                        </MudSelect>
                                        <MudSelect T="DdsStepMode" @bind-Value="step.Mode" Label="실행 방식"
                                                   Variant="Variant.Outlined" Margin="Margin.Dense">
                                            <MudSelectItem T="DdsStepMode" Value="@DdsStepMode.Manual">수동 / 순차 실행</MudSelectItem>
                                            <MudSelectItem T="DdsStepMode" Value="@DdsStepMode.Periodic">주기 발행</MudSelectItem>
                                            <MudSelectItem T="DdsStepMode" Value="@DdsStepMode.Bulk">다발 발행</MudSelectItem>
                                            <MudSelectItem T="DdsStepMode" Value="@DdsStepMode.OnIncoming">수신 반응 발행</MudSelectItem>
                                        </MudSelect>
                                        <MudNumericField @bind-Value="step.RepeatCount" Label="이 단계 발행 횟수"
                                                         Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        <MudNumericField @bind-Value="step.DelayAfterMs" Label="다음 단계 전 대기(ms)"
                                                         Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    </div>
                                    @if (step.Mode == DdsStepMode.Periodic)
                                    {
                                        <div class="wb-home-form">
                                            <MudNumericField @bind-Value="step.IntervalMs" Label="주기(ms)"
                                                             Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            <MudNumericField @bind-Value="step.MaxFires" Label="최대 발행 수(선택)"
                                                             Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        </div>
                                    }
                                    else if (step.Mode == DdsStepMode.Bulk)
                                    {
                                        <div class="wb-home-form">
                                            <MudNumericField @bind-Value="step.BulkCount" Label="다발 개수"
                                                             Min="1" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            <MudCheckBox @bind-Value="step.BulkParallel"
                                                         Label="병렬 발행"
                                                         Color="Color.Warning" />
                                        </div>
                                    }
                                    else if (step.Mode == DdsStepMode.OnIncoming)
                                    {
                                        <div class="wb-home-form">
                                            <MudSelect T="string" Label="매칭 source 토픽"
                                                       Value="@step.MatchTopicName"
                                                       ValueChanged="@((string? topicName) => OnScenarioStepMatchTopicChanged(step, topicName))"
                                                       Variant="Variant.Outlined" Margin="Margin.Dense">
                                                @foreach (var t in Session.Topics)
                                                {
                                                    <MudSelectItem T="string" Value="@t.TopicName">@t.TopicName</MudSelectItem>
                                                }
                                            </MudSelect>
                                            <MudNumericField @bind-Value="step.MinFireIntervalMs" Label="최소 발행 간격(ms)"
                                                             Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                            <MudNumericField @bind-Value="step.MaxFiresPerMinute" Label="분당 최대 발행 수"
                                                             Min="0" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        </div>
                                        <MudCheckBox @bind-Value="step.BlockSelfTopicLoop"
                                                     Label="동일 source/target 재발행 차단"
                                                     Color="Color.Warning" />
                                    }

                                    @if (FindGrpcMatch(step.TopicName) is string stepMatch)
                                    {
                                        <div class="d-flex align-center mb-2" style="gap:6px;">
                                            <MudIcon Icon="@Icons.Material.Filled.SwapHoriz" Size="Size.Small" Color="Color.Success" />
                                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Class="ma-0">
                                                ambassador 매칭: @stepMatch
                                            </MudChip>
                                        </div>
                                    }

                                    @{ var stepFields = GetScenarioStepSchemaFields(step); }
                                    @if (stepFields.Count == 0)
                                    {
                                        <MudTextField @bind-Value="step.JsonPayload" Lines="6" Variant="Variant.Outlined"
                                                      Margin="Margin.Dense" Label="메시지 Payload JSON" />
                                    }
                                    else
                                    {
                                        <div class="wb-subpanel mt-2 pa-3">
                                            <div class="wb-panel-kicker">메시지 필드</div>
                                            <div class="wb-panel-heading">필드별로 값을 선택하면 JSON이 자동 반영됩니다</div>
                                            <div class="wb-scroll mt-2" style="max-height:34vh;">
                                                @foreach (var field in stepFields)
                                                {
                                                    <div class="mb-2">
                                                        <SchemaFormField Field="field" OnChanged="@(() => OnScenarioStepFieldChanged(step))" />
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }

                </div>
                </div>
            </MudItem>

            <MudItem xs="12">
                <div class="wb-panel wb-panel--major wb-panel--contain pa-3 mb-4">
                    <div class="d-flex align-center mb-2" style="gap:8px;">
                        <MudIcon Icon="@Icons.Material.Filled.Feed" Size="Size.Small" Color="Color.Info" />
                        <div>
                            <div class="wb-panel-kicker">세션 / 시스템 로그</div>
                            <div class="wb-panel-heading">세션 범위 영속 로그</div>
                        </div>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@Session.LogEntries.Count</MudChip>
                        <MudSpacer />
                        <MudButton Variant="Variant.Outlined" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.CleaningServices"
                                   OnClick="ClearLogs">로그 비우기</MudButton>
                    </div>

                    @if (Session.LogEntries.Count == 0)
                    {
                        <div class="wb-empty"><div>로그 없음</div></div>
                    }
                    else
                    {
                        <div class="wb-scroll" style="max-height:260px;">
                            @foreach (var entry in Session.LogEntries)
                            {
                                <div class="wb-call-row wb-message-row mb-1">
                                    <div class="wb-message-row-main">
                                        <span class="wb-mono">@entry.TimestampUtc.ToLocalTime().ToString("HH:mm:ss")</span>
                                        <MudChip T="string" Size="Size.Small"
                                                 Color="@LogColor(entry.Level)" Variant="Variant.Text" Class="ma-0">@entry.Level</MudChip>
                                        <span class="wb-inline-note">@entry.Scope</span>
                                    </div>
                                    <div style="font-size:.8rem;">@entry.Message</div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </MudItem>
        </MudGrid>

        <MudOverlay Visible="@_showReceiveTopicPicker" DarkBackground="true" AutoClose="false" ZIndex="1500">
            <div class="wb-topic-picker-shell">
                <div class="wb-panel wb-panel--major wb-panel--contain wb-topic-picker pa-4">
                    <div class="d-flex align-center mb-3" style="gap:8px;">
                        <MudIcon Icon="@Icons.Material.Filled.Checklist" Size="Size.Small" Color="Color.Info" />
                        <div>
                            <div class="wb-panel-kicker">수신 토픽 선택</div>
                            <div class="wb-panel-heading">수신할 DDS 토픽을 체크하세요</div>
                        </div>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@SelectedReceivableTopicCount 선택</MudChip>
                        <MudSpacer />
                        <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Close"
                                   OnClick="CloseReceiveTopicPicker">닫기</MudButton>
                    </div>

                    <div class="wb-scroll wb-topic-picker-list">
                        @foreach (var topic in ReceivableTopics)
                        {
                            var isActive = ActiveSubscriptions.Any(s => s.TopicName == topic.TopicName);
                            <div class="wb-subpanel mb-2 pa-3">
                                <div class="d-flex align-center" style="gap:8px;">
                                    <MudCheckBox T="bool"
                                                 Value="@IsSubscriptionTopicSelected(topic.TopicName)"
                                                 ValueChanged="@((bool value) => OnSubscriptionTopicChecked(topic.TopicName, value))"
                                                 Label="@topic.TopicName"
                                                 Color="Color.Primary" />
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@topic.TypeName</MudChip>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@topic.QosProfileName</MudChip>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@topic.Direction</MudChip>
                                    @if (isActive)
                                    {
                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Class="ma-0">활성</MudChip>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    <div class="d-flex align-center justify-end mt-3 wb-topic-picker-actions" style="gap:8px;">
                        <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                                   OnClick="SelectAllSubscriptionTopics">전체선택</MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small"
                                   OnClick="ClearSelectedSubscriptionTopics">전체해제</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Done"
                                   OnClick="CloseReceiveTopicPicker">선택 완료</MudButton>
                    </div>
                </div>
            </div>
        </MudOverlay>
}

@code {
    [Parameter] public DdsSession? Session { get; set; }

    private readonly HashSet<string> _selectedSubscriptionTopics = [];
    private readonly Dictionary<string, List<SchemaField>> _scenarioStepSchemaFields = [];
    private bool _showReceiveTopicPicker;
    private string? _selectedSubscriptionId;
    private long _selectedSampleSeq = 0;

    private string _scenarioDraftTopicName = "";
    private DdsTopicConfig? _scenarioDraftTopic;
    private string _scenarioDraftJson = "{}";
    private bool _scenarioDraftRawJsonMode;
    private List<SchemaField> _scenarioDraftSchemaFields = [];
    private string? _scenarioDraftMatchTopicName;

    private bool _showTypesXml;
    private bool _showConfigXml;

    private bool _runningScenario;
    private bool _automationRunning;
    private CancellationTokenSource? _scenarioCts;
    private string _automationSignature = string.Empty;

    private const int MaxLogEntries = 500;

    private IReadOnlyList<DdsTopicConfig> ReceivableTopics
        => Session == null
            ? []
            : Session.Topics.Where(t => t.Direction != DdsTopicDirection.Publish).ToList();

    private IReadOnlyList<DdsSubscriptionInfo> ActiveSubscriptions
        => Session == null ? [] : DdsState.SnapshotSubscriptions(Session.SessionId);

    private DdsSubscriptionInfo? SelectedSubscription
        => Session == null || string.IsNullOrWhiteSpace(_selectedSubscriptionId)
            ? null
            : DdsState.SnapshotSubscriptions(Session.SessionId)
                .FirstOrDefault(s => s.SubscriptionId == _selectedSubscriptionId);

    private int SelectedReceivableTopicCount
        => ReceivableTopics.Count(topic => _selectedSubscriptionTopics.Contains(topic.TopicName));

    private IReadOnlyList<string> SelectedReceivableTopicNames
        => ReceivableTopics
            .Where(topic => _selectedSubscriptionTopics.Contains(topic.TopicName))
            .Select(topic => topic.TopicName)
            .ToList();

    private int SelectedActiveSubscriptionCount
        => ActiveSubscriptions.Count(subscription => _selectedSubscriptionTopics.Contains(subscription.TopicName));

    private int SelectedStartableSubscriptionCount
        => ReceivableTopics.Count(topic => _selectedSubscriptionTopics.Contains(topic.TopicName)
            && ActiveSubscriptions.All(active => active.TopicName != topic.TopicName));

    private DdsTopicConfig? DefaultPublishTopic
        => Session?.Topics.FirstOrDefault(topic => topic.Direction != DdsTopicDirection.Subscribe);

    private int ManualScenarioStepCount
        => Session?.ScenarioSteps.Count(step => step.Mode == DdsStepMode.Manual) ?? 0;

    private int AutomaticScenarioStepCount
        => Session?.ScenarioSteps.Count(step => step.Mode != DdsStepMode.Manual) ?? 0;

    private bool CanPublishScenarioDraft
        => _scenarioDraftTopic != null && _scenarioDraftTopic.Direction != DdsTopicDirection.Subscribe;

    private IReadOnlyList<DdsOutboundEntry> RecentOutbound
        => Session == null ? [] : DdsState.SnapshotOutbound(Session.SessionId, 10);

    protected override void OnInitialized()
    {
        DdsState.StateChanged += OnDdsStateChanged;
        DdsState.SampleReceived += OnSampleReceived;
    }

    protected override void OnParametersSet()
    {
        if (Session == null) return;

        foreach (var activeSubscription in ActiveSubscriptions)
        {
            _selectedSubscriptionTopics.Add(activeSubscription.TopicName);
        }

        if (SelectedSubscription == null)
            _selectedSubscriptionId = ActiveSubscriptions.FirstOrDefault()?.SubscriptionId;

        if (_scenarioDraftTopic == null && Session.Topics.Count > 0)
        {
            var publishable = Session.Topics.FirstOrDefault(t => t.Direction != DdsTopicDirection.Subscribe) ?? Session.Topics[0];
            _scenarioDraftTopicName = publishable.TopicName;
            _scenarioDraftTopic = publishable;
        }
        BuildScenarioDraftSchemaForTopic();

        foreach (var step in Session.ScenarioSteps)
            EnsureScenarioStepSchema(step);

        Session.ScenarioOptions.CycleCount = Math.Max(1, Session.ScenarioOptions.CycleCount);
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (Session == null)
            return;

        var nextSignature = ComputeAutomationSignature();
        if (nextSignature == _automationSignature)
            return;

        _automationSignature = nextSignature;
        SyncScenarioAutomationTriggers();
    }

    private void BuildScenarioDraftSchemaForTopic()
    {
        if (Session == null || _scenarioDraftTopic == null)
        {
            _scenarioDraftSchemaFields = [];
            _scenarioDraftJson = "{}";
            return;
        }

        _scenarioDraftSchemaFields = BuildSchemaFieldsForType(_scenarioDraftTopic.TypeName);
        _scenarioDraftRawJsonMode = false;
        BuildScenarioDraftJsonFromForm();
    }

    private List<SchemaField> BuildSchemaFieldsForType(string typeName)
    {
        if (Session == null)
            return [];

        if (!Session.Types.TryGetValue(typeName, out var typeDef) || typeDef.Kind != DdsTypeKind.Struct)
        {
            return [];
        }

        var next = new List<SchemaField>();
        foreach (var member in typeDef.Members)
        {
            next.Add(BuildSchemaField(member));
        }

        return next;
    }

    private SchemaField BuildSchemaField(DdsTypeMember member)
    {
        if (member.IsArray || member.IsSequence)
        {
            return new SchemaField
            {
                Name = member.Name,
                Type = "array",
                Value = "[]",
                ItemTemplate = BuildArrayItemTemplate(member),
            };
        }

        if (Session != null && Session.Types.TryGetValue(member.TypeName, out var nestedType))
        {
            if (nestedType.Kind == DdsTypeKind.Enum)
            {
                return new SchemaField
                {
                    Name = member.Name,
                    Type = "enum",
                    EnumValues = nestedType.EnumValues.Keys.ToArray(),
                    Value = nestedType.EnumValues.Keys.FirstOrDefault() ?? string.Empty,
                };
            }

            if (nestedType.Kind == DdsTypeKind.Struct)
            {
                return new SchemaField
                {
                    Name = member.Name,
                    Type = "object",
                    Value = "{}",
                    Children = nestedType.Members.Select(BuildSchemaField).ToList(),
                };
            }
        }

        return new SchemaField
        {
            Name = member.Name,
            Type = MapPrimitiveType(member.TypeName),
            Value = DefaultValueForPrimitive(member.TypeName),
            BoolValue = false,
        };
    }

    private SchemaField BuildArrayItemTemplate(DdsTypeMember member)
    {
        if (Session != null && Session.Types.TryGetValue(member.TypeName, out var nestedType))
        {
            if (nestedType.Kind == DdsTypeKind.Struct)
            {
                return new SchemaField
                {
                    Name = "0",
                    Type = "object",
                    Value = "{}",
                    Children = nestedType.Members.Select(BuildSchemaField).ToList(),
                };
            }

            if (nestedType.Kind == DdsTypeKind.Enum)
            {
                return new SchemaField
                {
                    Name = "0",
                    Type = "enum",
                    EnumValues = nestedType.EnumValues.Keys.ToArray(),
                    Value = nestedType.EnumValues.Keys.FirstOrDefault() ?? string.Empty,
                };
            }
        }

        return new SchemaField
        {
            Name = "0",
            Type = MapPrimitiveType(member.TypeName),
            Value = DefaultValueForPrimitive(member.TypeName),
        };
    }

    private static string MapPrimitiveType(string typeName)
    {
        var normalized = typeName.ToLowerInvariant();
        return normalized switch
        {
            "boolean" or "bool" => "boolean",
            "int8" or "int16" or "int32" or "int64" or "uint8" or "uint16" or "uint32" or "uint64" or "long" or "ulong" or "short" or "ushort" => "integer",
            "float" or "float32" or "float64" or "double" => "number",
            _ => "string",
        };
    }

    private static string DefaultValueForPrimitive(string typeName)
    {
        var primitive = MapPrimitiveType(typeName);
        return primitive switch
        {
            "integer" or "number" => "0",
            _ => string.Empty,
        };
    }

    private void OnScenarioDraftRawModeChanged(bool raw)
    {
        _scenarioDraftRawJsonMode = raw;
        if (_scenarioDraftSchemaFields.Count == 0)
            return;

        if (raw)
            BuildScenarioDraftJsonFromForm();
        else
            TryPopulatePublishFieldsFromJson(_scenarioDraftJson);
    }

    private void BuildScenarioDraftJsonFromForm()
    {
        _scenarioDraftJson = JsonSerializer.Serialize(
            BuildJsonObject(_scenarioDraftSchemaFields),
            new JsonSerializerOptions { WriteIndented = true });
    }

    private static Dictionary<string, object?> BuildJsonObject(List<SchemaField> fields)
    {
        var obj = new Dictionary<string, object?>();
        foreach (var field in fields)
            obj[field.Name] = BuildFieldValue(field);
        return obj;
    }

    private static object? BuildFieldValue(SchemaField field) => field.Type switch
    {
        "boolean" => field.BoolValue,
        "integer" => long.TryParse(field.Value, out var longValue) ? longValue : 0L,
        "number" => double.TryParse(field.Value, System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture, out var doubleValue) ? doubleValue : 0.0,
        "object" when field.Children.Count > 0 => BuildJsonObject(field.Children),
        "object" => TryParseRaw(field.Value),
        "array" when field.ItemTemplate != null => field.ArrayItems.Select(BuildFieldValue).ToArray(),
        "array" => TryParseRaw(field.Value),
        _ => (object?)field.Value
    };

    private static object? TryParseRaw(string value)
    {
        try
        {
            using var doc = JsonDocument.Parse(value);
            return doc.RootElement.Clone();
        }
        catch
        {
            return value;
        }
    }

    private void TryPopulatePublishFieldsFromJson(string? json)
    {
        if (_scenarioDraftSchemaFields.Count == 0 || string.IsNullOrWhiteSpace(json)) return;

        try
        {
            using var doc = JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind != JsonValueKind.Object)
                return;

            ApplyObjectToFields(_scenarioDraftSchemaFields, doc.RootElement);
        }
        catch
        {
        }
    }

    private static void ApplyObjectToFields(List<SchemaField> fields, JsonElement element)
    {
        foreach (var field in fields)
        {
            if (!element.TryGetProperty(field.Name, out var value))
                continue;
            ApplyJsonToField(field, value);
        }
    }

    private static void ApplyJsonToField(SchemaField field, JsonElement value)
    {
        switch (field.Type)
        {
            case "boolean":
                field.BoolValue = value.ValueKind == JsonValueKind.True || (value.ValueKind == JsonValueKind.False ? false : field.BoolValue);
                break;
            case "integer":
            case "number":
            case "string":
            case "enum":
                field.Value = value.ValueKind == JsonValueKind.String ? value.GetString() ?? string.Empty : value.ToString();
                break;
            case "object":
                if (field.Children.Count > 0 && value.ValueKind == JsonValueKind.Object)
                    ApplyObjectToFields(field.Children, value);
                else
                    field.Value = value.GetRawText();
                break;
            case "array":
                if (field.ItemTemplate != null && value.ValueKind == JsonValueKind.Array)
                {
                    field.ArrayItems.Clear();
                    var index = 0;
                    foreach (var item in value.EnumerateArray())
                    {
                        var clone = field.ItemTemplate.DeepClone(index.ToString());
                        ApplyJsonToField(clone, item);
                        field.ArrayItems.Add(clone);
                        index++;
                    }
                }
                else
                {
                    field.Value = value.GetRawText();
                }
                break;
            default:
                field.Value = value.ToString();
                break;
        }
    }

    private bool IsSubscriptionTopicSelected(string topicName)
    {
        return _selectedSubscriptionTopics.Contains(topicName);
    }

    private void OpenReceiveTopicPicker()
    {
        _showReceiveTopicPicker = true;
    }

    private void CloseReceiveTopicPicker()
    {
        _showReceiveTopicPicker = false;
    }

    private void OnSubscriptionTopicChecked(string topicName, bool selected)
    {
        if (selected)
            _selectedSubscriptionTopics.Add(topicName);
        else
            _selectedSubscriptionTopics.Remove(topicName);

        StateHasChanged();
    }

    private void RemoveSelectedSubscriptionTopic(string topicName)
    {
        _selectedSubscriptionTopics.Remove(topicName);
    }

    private void ClearSelectedSubscriptionTopics()
    {
        _selectedSubscriptionTopics.Clear();
    }

    private void SelectAllSubscriptionTopics()
    {
        foreach (var topic in ReceivableTopics)
            _selectedSubscriptionTopics.Add(topic.TopicName);
    }

    private void SelectSubscription(string subscriptionId)
    {
        _selectedSubscriptionId = subscriptionId;
        _selectedSampleSeq = 0;
    }

    private void OnScenarioDraftTopicChanged(string topicName)
    {
        _scenarioDraftTopicName = topicName;
        _scenarioDraftTopic = Session?.Topics.FirstOrDefault(t => t.TopicName == topicName);
        BuildScenarioDraftSchemaForTopic();

        if (string.IsNullOrWhiteSpace(_scenarioDraftMatchTopicName))
            _scenarioDraftMatchTopicName = topicName;
    }

    private void OnScenarioDraftMatchTopicChanged(string? topicName)
    {
        _scenarioDraftMatchTopicName = topicName;
    }

    private void StartSelectedSubscriptions()
    {
        if (Session == null) return;

        var topicsToStart = ReceivableTopics
            .Where(topic => _selectedSubscriptionTopics.Contains(topic.TopicName))
            .Where(topic => ActiveSubscriptions.All(active => active.TopicName != topic.TopicName))
            .ToList();

        if (topicsToStart.Count == 0)
        {
            Snackbar.Add("수신 시작할 토픽이 없습니다.", Severity.Info);
            return;
        }

        try
        {
            foreach (var topic in topicsToStart)
            {
                var info = DdsState.StartSubscription(
                    Session.SessionId, topic.TopicName, topic.TypeName, topic.QosProfileName);
                _selectedSubscriptionId ??= info.SubscriptionId;
                AppendLog("session", "INFO", $"수신 시작: {topic.TopicName}");
            }

            Snackbar.Add($"수신 시작: {topicsToStart.Count}개 토픽", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"수신 시작 실패: {ex.Message}", Severity.Error);
            AppendLog("system", "ERROR", $"수신 시작 실패: {ex.Message}");
        }
    }

    private void StopSelectedSubscriptions()
    {
        var targets = ActiveSubscriptions
            .Where(subscription => _selectedSubscriptionTopics.Contains(subscription.TopicName))
            .Select(subscription => subscription.SubscriptionId)
            .ToList();

        if (targets.Count == 0)
        {
            Snackbar.Add("중지할 수신 토픽이 없습니다.", Severity.Info);
            return;
        }

        foreach (var subscriptionId in targets)
            DdsState.StopSubscription(subscriptionId);

        if (_selectedSubscriptionId is not null && targets.Contains(_selectedSubscriptionId))
            _selectedSubscriptionId = ActiveSubscriptions.FirstOrDefault(subscription => !targets.Contains(subscription.SubscriptionId))?.SubscriptionId;

        _selectedSampleSeq = 0;
        AppendLog("session", "INFO", $"수신 중지: {targets.Count}개 토픽");
    }

    private void LoadScenarioDraftTemplate()
    {
        if (Session == null || _scenarioDraftTopic == null) return;
        try
        {
            var host = DdsSessions.GetHost(Session.SessionId);
            if (host == null) return;
            using var sample = host.CreateSample(_scenarioDraftTopic.TypeName);
            _scenarioDraftJson = DdsJsonConverter.ToJson(sample, pretty: true);
            TryPopulatePublishFieldsFromJson(_scenarioDraftJson);
            BuildScenarioDraftJsonFromForm();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"템플릿 생성 실패: {ex.Message}", Severity.Warning);
            AppendLog("system", "WARN", $"템플릿 생성 실패: {ex.Message}");
        }
    }

    private void AddScenarioStep()
    {
        if (Session == null) return;

        var publishTopic = DefaultPublishTopic;
        if (publishTopic == null)
        {
            Snackbar.Add("발행 가능한 토픽이 없습니다.", Severity.Warning);
            return;
        }

        var step = new DdsScenarioStep
        {
            Name = string.Empty,
            TopicName = publishTopic.TopicName,
            TypeName = publishTopic.TypeName,
            QosProfileName = publishTopic.QosProfileName,
            JsonPayload = CreateDefaultScenarioPayloadJson(publishTopic.TypeName),
            RepeatCount = 1,
            DelayAfterMs = 0,
            Mode = DdsStepMode.Manual,
            AutoEnabled = false,
            IntervalMs = 1000,
            MaxFires = null,
            BulkCount = 10,
            BulkParallel = false,
            MatchTopicName = publishTopic.TopicName,
            BlockSelfTopicLoop = true,
            MinFireIntervalMs = 0,
            MaxFiresPerMinute = 0,
        };

        Session.ScenarioSteps.Add(step);
        EnsureScenarioStepSchema(step);
        AppendLog("session", "INFO", $"메시지 단계 추가: {step.TopicName}");
    }

    private void OnScenarioStepTopicChanged(DdsScenarioStep step, string topicName)
    {
        if (Session == null) return;

        step.TopicName = topicName;
        var topic = Session.Topics.FirstOrDefault(t => t.TopicName == topicName);
        if (topic == null) return;

        step.TypeName = topic.TypeName;
        step.QosProfileName = topic.QosProfileName;
        step.JsonPayload = CreateDefaultScenarioPayloadJson(topic.TypeName);
        ResetScenarioStepSchema(step);
    }

    private void OnScenarioStepMatchTopicChanged(DdsScenarioStep step, string? topicName)
    {
        step.MatchTopicName = topicName;
    }

    private void RemoveScenarioStep(int index)
    {
        if (Session == null) return;
        if (index < 0 || index >= Session.ScenarioSteps.Count) return;
        var removed = Session.ScenarioSteps[index];
        Session.ScenarioSteps.RemoveAt(index);
        _scenarioStepSchemaFields.Remove(removed.Id);
        Snackbar.Add("메시지 단계를 삭제했습니다.", Severity.Info);
        AppendLog("session", "INFO", $"메시지 단계 삭제: {removed.TopicName}");
    }

    private IReadOnlyList<SchemaField> GetScenarioStepSchemaFields(DdsScenarioStep step)
    {
        EnsureScenarioStepSchema(step);
        return _scenarioStepSchemaFields.TryGetValue(step.Id, out var fields) ? fields : [];
    }

    private void EnsureScenarioStepSchema(DdsScenarioStep step)
    {
        if (_scenarioStepSchemaFields.ContainsKey(step.Id))
            return;

        var fields = BuildSchemaFieldsForType(step.TypeName);
        if (fields.Count == 0)
            return;

        _scenarioStepSchemaFields[step.Id] = fields;
        TryPopulateFieldsFromJson(fields, step.JsonPayload);
        BuildScenarioStepJsonFromFields(step);
    }

    private void ResetScenarioStepSchema(DdsScenarioStep step)
    {
        _scenarioStepSchemaFields.Remove(step.Id);
        EnsureScenarioStepSchema(step);
    }

    private void OnScenarioStepFieldChanged(DdsScenarioStep step)
    {
        BuildScenarioStepJsonFromFields(step);
    }

    private void BuildScenarioStepJsonFromFields(DdsScenarioStep step)
    {
        if (!_scenarioStepSchemaFields.TryGetValue(step.Id, out var fields) || fields.Count == 0)
            return;

        step.JsonPayload = JsonSerializer.Serialize(
            BuildJsonObject(fields),
            new JsonSerializerOptions { WriteIndented = true });
    }

    private void TryPopulateFieldsFromJson(List<SchemaField> fields, string? json)
    {
        if (fields.Count == 0 || string.IsNullOrWhiteSpace(json))
            return;

        try
        {
            using var doc = JsonDocument.Parse(json);
            if (doc.RootElement.ValueKind != JsonValueKind.Object)
                return;

            ApplyObjectToFields(fields, doc.RootElement);
        }
        catch
        {
        }
    }

    private void StartAutomation()
    {
        if (Session == null || AutomaticScenarioStepCount == 0)
            return;

        _automationRunning = true;
        SyncScenarioAutomationTriggers();
        Snackbar.Add("DDS 자동화를 시작했습니다.", Severity.Success);
        AppendLog("session", "INFO", $"자동화 시작: {AutomaticScenarioStepCount} step");
    }

    private void StopAutomation()
    {
        if (Session == null || !_automationRunning)
            return;

        _automationRunning = false;
        SyncScenarioAutomationTriggers();
        Snackbar.Add("DDS 자동화를 중지했습니다.", Severity.Info);
        AppendLog("session", "INFO", "자동화 중지");
    }

    private string CreateDefaultScenarioPayloadJson(string typeName)
    {
        if (Session == null)
            return "{}";

        try
        {
            var host = DdsSessions.GetHost(Session.SessionId);
            if (host == null)
                return "{}";

            using var sample = host.CreateSample(typeName);
            return DdsJsonConverter.ToJson(sample, pretty: true);
        }
        catch
        {
            return "{}";
        }
    }

    private async Task RunScenario()
    {
        if (Session == null || ManualScenarioStepCount == 0 || _runningScenario) return;

        _runningScenario = true;
        _scenarioCts = new CancellationTokenSource();
        var ct = _scenarioCts.Token;
        var options = Session.ScenarioOptions;
        var manualSteps = Session.ScenarioSteps.Where(step => step.Mode == DdsStepMode.Manual).ToList();

        AppendLog("session", "INFO", $"수동 실행 시작: {manualSteps.Count} step, cycle {options.CycleCount}");

        try
        {
            for (var cycle = 1; cycle <= Math.Max(1, options.CycleCount); cycle++)
            {
                for (var i = 0; i < manualSteps.Count; i++)
                {
                    ct.ThrowIfCancellationRequested();
                    var step = manualSteps[i];

                    for (var repeat = 1; repeat <= Math.Max(1, step.RepeatCount); repeat++)
                    {
                        ct.ThrowIfCancellationRequested();
                        var result = await Task.Run(() => DdsState.Publish(
                            Session.SessionId,
                            step.TopicName,
                            step.TypeName,
                            step.QosProfileName,
                            step.JsonPayload), ct);

                        if (!result.Success)
                        {
                            AppendLog("system", "ERROR", $"cycle {cycle} step {i + 1}/{manualSteps.Count} 실패: {result.Error}");
                            if (options.StopOnError)
                            {
                                AppendLog("system", "WARN", "오류 발생으로 수동 실행 중단");
                                return;
                            }
                        }
                        else
                        {
                            AppendLog("session", "INFO", $"cycle {cycle} step {i + 1}/{manualSteps.Count} repeat {repeat}/{Math.Max(1, step.RepeatCount)} 성공");
                        }
                    }

                    var delayMs = Math.Max(0, step.DelayAfterMs);
                    if (delayMs > 0)
                        await Task.Delay(delayMs, ct);
                }
            }

            Snackbar.Add("DDS 수동 실행 완료", Severity.Success);
            AppendLog("session", "INFO", "수동 실행 완료");
        }
        catch (OperationCanceledException)
        {
            Snackbar.Add("DDS 수동 실행 중단", Severity.Warning);
            AppendLog("system", "WARN", "사용자 요청으로 수동 실행 중단");
        }
        finally
        {
            _runningScenario = false;
            _scenarioCts?.Dispose();
            _scenarioCts = null;
        }
    }

    private void StopScenario()
    {
        _scenarioCts?.Cancel();
    }

    private async Task ExportScenarioJson()
    {
        if (Session == null || Session.ScenarioSteps.Count == 0)
        {
            Snackbar.Add("저장할 메시지 단계가 없습니다.", Severity.Warning);
            return;
        }

        var payload = new DdsScenarioExportFile
        {
            Version = 1,
            ExportedAt = DateTimeOffset.Now,
            Options = Session.ScenarioOptions,
            Steps = Session.ScenarioSteps.ToList(),
        };

        var json = JsonSerializer.Serialize(payload, new JsonSerializerOptions { WriteIndented = true });
        await JS.InvokeVoidAsync("workbench.downloadText", $"dds-scenario-{SanitizeFileName(Session.Name)}.json", json, "application/json");
        Snackbar.Add($"DDS 단계 저장 완료: {Session.ScenarioSteps.Count} step", Severity.Success);
        AppendLog("session", "INFO", $"단계 저장: {Session.ScenarioSteps.Count} step");
    }

    private async Task ImportScenarioJson(IBrowserFile? file)
    {
        if (Session == null || file == null) return;

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            var payload = JsonSerializer.Deserialize<DdsScenarioExportFile>(json);

            if (payload?.Steps == null || payload.Steps.Count == 0)
            {
                Snackbar.Add("불러올 DDS 단계가 없습니다.", Severity.Warning);
                return;
            }

            Session.ScenarioSteps = payload.Steps
                .Where(step => !string.IsNullOrWhiteSpace(step.TopicName) && !string.IsNullOrWhiteSpace(step.TypeName))
                .Select(step => new DdsScenarioStep
                {
                    Id = string.IsNullOrWhiteSpace(step.Id) ? Guid.NewGuid().ToString() : step.Id,
                    Name = step.Name,
                    TopicName = step.TopicName,
                    TypeName = step.TypeName,
                    QosProfileName = step.QosProfileName,
                    JsonPayload = string.IsNullOrWhiteSpace(step.JsonPayload) ? "{}" : step.JsonPayload,
                    RepeatCount = Math.Max(1, step.RepeatCount),
                    DelayAfterMs = Math.Max(0, step.DelayAfterMs),
                    Mode = step.Mode,
                    AutoEnabled = step.Mode != DdsStepMode.Manual,
                    IntervalMs = Math.Max(1, step.IntervalMs),
                    MaxFires = step.MaxFires,
                    BulkCount = Math.Max(1, step.BulkCount),
                    BulkParallel = step.BulkParallel,
                    MatchTopicName = step.MatchTopicName,
                    BlockSelfTopicLoop = step.BlockSelfTopicLoop,
                    MinFireIntervalMs = Math.Max(0, step.MinFireIntervalMs),
                    MaxFiresPerMinute = Math.Max(0, step.MaxFiresPerMinute),
                })
                .ToList();

            _scenarioStepSchemaFields.Clear();
            foreach (var step in Session.ScenarioSteps)
                EnsureScenarioStepSchema(step);

            Session.ScenarioOptions = payload.Options ?? new DdsScenarioRunOptions();
            Session.ScenarioOptions.CycleCount = Math.Max(1, Session.ScenarioOptions.CycleCount);

            Snackbar.Add($"DDS 단계 불러오기 완료: {Session.ScenarioSteps.Count} step", Severity.Success);
            AppendLog("session", "INFO", $"단계 불러오기: {Session.ScenarioSteps.Count} step");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"DDS 단계 불러오기 실패: {ex.Message}", Severity.Error);
            AppendLog("system", "ERROR", $"단계 불러오기 실패: {ex.Message}");
        }
    }

    private void ClearLogs()
    {
        Session?.LogEntries.Clear();
    }

    private string ComputeAutomationSignature()
    {
        if (Session == null)
            return string.Empty;

        return string.Join('|', Session.ScenarioSteps.Select(step => string.Join(';',
            step.Id,
            step.TopicName,
            step.TypeName,
            step.QosProfileName,
            step.JsonPayload,
            step.Mode,
            _automationRunning,
            step.IntervalMs,
            step.MaxFires,
            step.BulkCount,
            step.BulkParallel,
            step.MatchTopicName,
            step.BlockSelfTopicLoop,
            step.MinFireIntervalMs,
            step.MaxFiresPerMinute)));
    }

    private void SyncScenarioAutomationTriggers()
    {
        if (Session == null)
            return;

        if (!_automationRunning)
        {
            Triggers.ReplaceSessionTriggers(Session.SessionId, []);
            return;
        }

        var triggers = Session.ScenarioSteps
            .Where(step => step.Mode != DdsStepMode.Manual)
            .Select(step => new DdsTrigger
            {
                Id = step.Id,
                Name = string.IsNullOrWhiteSpace(step.Name) ? step.TopicName : step.Name,
                SessionId = Session.SessionId,
                Type = step.Mode switch
                {
                    DdsStepMode.Periodic => DdsTriggerType.Periodic,
                    DdsStepMode.Bulk => DdsTriggerType.Bulk,
                    DdsStepMode.OnIncoming => DdsTriggerType.OnIncoming,
                    _ => DdsTriggerType.Periodic,
                },
                Enabled = _automationRunning,
                TopicName = step.TopicName,
                TypeName = step.TypeName,
                QosProfileName = step.QosProfileName,
                JsonPayload = step.JsonPayload,
                IntervalMs = Math.Max(1, step.IntervalMs),
                MaxFires = step.MaxFires,
                BulkCount = Math.Max(1, step.BulkCount),
                BulkParallel = step.BulkParallel,
                MatchTopicName = step.MatchTopicName,
                BlockSelfTopicLoop = step.BlockSelfTopicLoop,
                MinFireIntervalMs = Math.Max(0, step.MinFireIntervalMs),
                MaxFiresPerMinute = Math.Max(0, step.MaxFiresPerMinute),
            })
            .ToList();

        Triggers.ReplaceSessionTriggers(Session.SessionId, triggers);
    }

    private static string StepModeLabel(DdsStepMode mode) => mode switch
    {
        DdsStepMode.Periodic => "주기",
        DdsStepMode.Bulk => "다발",
        DdsStepMode.OnIncoming => "수신반응",
        _ => "수동",
    };

    private void OnSampleReceived(DdsSubscriptionInfo info, DdsSampleEntry sample)
    {
        if (Session == null || info.SessionId != Session.SessionId) return;
        _selectedSubscriptionId ??= info.SubscriptionId;
        AppendLog("session", "INFO", $"수신: {info.TopicName} #{sample.SequenceNumber}");
    }

    private DdsTopicConfig? FindTopic(string topicName)
    {
        return Session?.Topics.FirstOrDefault(topic => topic.TopicName == topicName);
    }

    private async void OnDdsStateChanged()
    {
        await InvokeAsync(StateHasChanged);
    }

    private void AppendLog(string scope, string level, string message)
    {
        if (Session == null) return;

        Session.LogEntries.Insert(0, new DdsSessionLogEntry
        {
            TimestampUtc = DateTime.UtcNow,
            Scope = scope,
            Level = level,
            Message = message,
        });

        if (Session.LogEntries.Count > MaxLogEntries)
        {
            Session.LogEntries.RemoveRange(MaxLogEntries, Session.LogEntries.Count - MaxLogEntries);
        }
    }

    private static Color LogColor(string level) => level switch
    {
        "ERROR" => Color.Error,
        "WARN" => Color.Warning,
        _ => Color.Default,
    };

    private string GetTypesXmlText()
    {
        if (Session?.TypesXmlContent == null) return string.Empty;
        return System.Text.Encoding.UTF8.GetString(Session.TypesXmlContent);
    }

    private string GetConfigXmlText()
    {
        if (Session?.ConfigXmlContent == null) return string.Empty;
        return System.Text.Encoding.UTF8.GetString(Session.ConfigXmlContent);
    }

    private async Task DownloadTypesXml()
    {
        if (Session?.TypesXmlContent == null) return;
        var fileName = string.IsNullOrWhiteSpace(Session.TypesXmlFileName)
            ? "DDSSim.xml"
            : Session.TypesXmlFileName;
        await JS.InvokeVoidAsync("workbench.downloadText", fileName, GetTypesXmlText(), "application/xml");
    }

    private async Task DownloadConfigXml()
    {
        if (Session?.ConfigXmlContent == null) return;
        var fileName = string.IsNullOrWhiteSpace(Session.ConfigXmlFileName)
            ? "dds-config.xml"
            : Session.ConfigXmlFileName;
        await JS.InvokeVoidAsync("workbench.downloadText", fileName, GetConfigXmlText(), "application/xml");
    }

    public void Dispose()
    {
        DdsState.StateChanged -= OnDdsStateChanged;
        DdsState.SampleReceived -= OnSampleReceived;
        _scenarioCts?.Cancel();
        _scenarioCts?.Dispose();
    }

    private string? FindGrpcMatch(string topicName)
    {
        foreach (var svc in GrpcState.Services)
        {
            var m = svc.Methods.FirstOrDefault(x =>
                string.Equals(x.MethodName, topicName, StringComparison.Ordinal) ||
                string.Equals(x.MethodName, "Stream" + topicName, StringComparison.Ordinal));
            if (m != null)
                return $"{svc.ServiceName.Split('.').Last()}.{m.MethodName}";
        }
        return null;
    }

    private static string SanitizeFileName(string value)
    {
        var invalid = Path.GetInvalidFileNameChars();
        var cleaned = new string(value.Select(ch => invalid.Contains(ch) ? '-' : ch).ToArray()).Trim();
        return string.IsNullOrWhiteSpace(cleaned) ? "dds-scenario" : cleaned;
    }

    private sealed class DdsScenarioExportFile
    {
        public int Version { get; set; }
        public DateTimeOffset ExportedAt { get; set; }
        public DdsScenarioRunOptions? Options { get; set; }
        public List<DdsScenarioStep> Steps { get; set; } = [];
    }

