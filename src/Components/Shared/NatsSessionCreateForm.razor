@using ASAP.Models.Session
@using ASAP.Nats
@inject IConfiguration Configuration
@inject INatsSessionService NatsSessions
@inject ISnackbar Snackbar

<div class="wb-panel wb-panel--contain pa-3">
    <div class="wb-panel-kicker">새 NATS 세션</div>
    <div class="wb-panel-heading">브로커 URL만 정하면 바로 세션을 엽니다</div>

    <div class="wb-inline-note mt-2">같은 Pod 안의 broker를 테스트할 거면 기본값 그대로 `nats://localhost:4222`를 쓰면 됩니다.</div>

    <div class="wb-home-form mt-3">
        <MudTextField @bind-Value="_name" Label="세션 이름" Placeholder="예: Local broker"
                      Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudTextField @bind-Value="_url" Label="NATS URL" Placeholder="nats://localhost:4222"
                      Variant="Variant.Outlined" Margin="Margin.Dense" />
    </div>

    <div class="wb-inline-note mt-3">생성 후에는 DDS 화면과 비슷하게 수신 subject 목록, 메시지 목록, payload 상세를 분리해서 보게 됩니다.</div>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <div class="wb-inline-note mt-2" style="color:var(--mud-palette-error);">@_error</div>
    }

    <div class="d-flex mt-3" style="gap:8px;">
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="Submit" Disabled="_creating"
                   StartIcon="@Icons.Material.Filled.AddLink">
            @if (_creating)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <text>생성 중…</text>
            }
            else
            {
                <text>NATS 세션 생성</text>
            }
        </MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="OnCancelled">취소</MudButton>
    </div>
</div>

@code {
    [Parameter] public EventCallback<NatsSession> OnCreated { get; set; }
    [Parameter] public EventCallback OnCancelled { get; set; }

    private string _name = string.Empty;
    private string _url = string.Empty;
    private bool _creating;
    private string? _error;

    protected override void OnInitialized()
    {
        _url = Configuration["ASAP:NatsUrl"] ?? "nats://localhost:4222";
    }

    private async Task Submit()
    {
        _error = null;
        _creating = true;
        try
        {
            var session = await NatsSessions.CreateAsync(_url, _name);
            Snackbar.Add($"NATS 세션 생성: {session.Name}", Severity.Success);
            await OnCreated.InvokeAsync(session);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _creating = false;
        }
    }
}