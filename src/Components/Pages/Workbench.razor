@page "/"
@rendermode InteractiveServer
@using ASAP.Models.Session
@using ASAP.Services
@inject IDdsSessionService DdsSessions
@inject UiStateService Ui

<PageTitle>Signal Forge DDS</PageTitle>

<div class="wb-page pa-3">
    <div class="wb-session-shell mb-4">
        <div class="wb-session-tabs">
            @foreach (var session in _sessions)
            {
                <div class="wb-session-tab @(IsActive(session.SessionId) ? "is-active" : null)">
                    <button type="button" class="wb-session-tab-main"
                            @onclick="@(() => ActivateSession(session.SessionId))">
                        <span class="wb-session-tab-title">@SessionLabel(session)</span>
                        <span class="wb-session-tab-note">@SessionDetail(session)</span>
                    </button>
                    <button type="button" class="wb-session-tab-close" title="DDS 탭 닫기"
                            @onclick:stopPropagation="true"
                            @onclick="@(async () => await CloseSession(session.SessionId))">
                        <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                    </button>
                </div>
            }
            <button type="button"
                    class="wb-session-tab wb-session-tab--new @(_showCreateForm ? "is-active" : null)"
                    @onclick="ShowCreateForm">
                <span class="wb-session-tab-title">새 DDS 세션</span>
                <span class="wb-session-tab-note">Domain과 XML 설정</span>
            </button>
        </div>

        @if (_showCreateForm || _activeSession == null)
        {
            <div class="wb-panel wb-panel--contain pa-4 mt-3">
                <div class="wb-panel-kicker">DDS 세션</div>
                <div class="wb-panel-heading">Domain과 XML 설정으로 작업 공간을 엽니다</div>
                <div class="wb-inline-note mt-2">
                    DDS 발행·구독, 수신 데이터 확인, 트리거와 시나리오 자동화를 한 세션에서 관리합니다.
                </div>
                <div class="mt-3">
                    <DdsSessionCreateForm OnCreated="OnSessionCreated" OnCancelled="CancelCreate" />
                </div>
            </div>
        }
    </div>

    @if (!_showCreateForm && _activeSession != null)
    {
        <DdsSessionPanel Session="_activeSession" />
    }
</div>

@code {
    private List<DdsSession> _sessions = [];
    private DdsSession? _activeSession;
    private bool _showCreateForm;

    protected override void OnInitialized()
    {
        RefreshSessions();
        if (_sessions.Count > 0)
        {
            ActivateSession(_sessions[0].SessionId);
        }
        else
        {
            ShowCreateForm();
        }
    }

    private void RefreshSessions()
    {
        _sessions = DdsSessions.GetAll()
            .OrderBy(session => session.CreatedAt)
            .ToList();
    }

    private bool IsActive(string sessionId)
        => !_showCreateForm
            && string.Equals(_activeSession?.SessionId, sessionId, StringComparison.Ordinal);

    private void ShowCreateForm()
    {
        _showCreateForm = true;
        Ui.SetWorkspace("새 DDS 세션", "Domain과 XML 설정");
    }

    private Task CancelCreate()
    {
        if (_activeSession != null)
        {
            _showCreateForm = false;
            SetWorkspace(_activeSession);
        }

        return Task.CompletedTask;
    }

    private Task OnSessionCreated(DdsSession session)
    {
        RefreshSessions();
        ActivateSession(session.SessionId);
        return Task.CompletedTask;
    }

    private void ActivateSession(string sessionId)
    {
        var session = DdsSessions.Get(sessionId);
        if (session == null)
        {
            RefreshSessions();
            return;
        }

        _activeSession = session;
        _showCreateForm = false;
        SetWorkspace(session);
    }

    private async Task CloseSession(string sessionId)
    {
        await DdsSessions.DeleteAsync(sessionId);
        RefreshSessions();

        if (_activeSession?.SessionId == sessionId)
        {
            _activeSession = null;
            if (_sessions.Count > 0)
            {
                ActivateSession(_sessions[0].SessionId);
            }
            else
            {
                ShowCreateForm();
            }
        }
    }

    private void SetWorkspace(DdsSession session)
        => Ui.SetWorkspace(SessionLabel(session), SessionDetail(session));

    private static string SessionLabel(DdsSession session)
        => string.IsNullOrWhiteSpace(session.Name)
            ? $"DDS {session.SessionId[..8]}"
            : session.Name;

    private static string SessionDetail(DdsSession session)
        => $"Domain {session.Transport.DomainId} · {session.Topics.Count}개 토픽";
}
