@page "/"
@rendermode InteractiveServer
@inject ISessionService SessionService
@inject IProtoLoader ProtoLoader
@inject IDynamicProtoCompiler ProtoCompiler
@inject IGrpcStreamingService StreamingService
@inject IUnaryGrpcService UnaryGrpcService
@inject IGrpcChannelProvider ChannelProvider
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment WebHostEnv
@inject IConfiguration Configuration
@inject WorkbenchNotificationService Notify
@inject UiStateService Ui
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>gRPC Workbench</PageTitle>

<div class="pa-3">
    <MudGrid Spacing="3">

        @* ════════ 좌측: 가이드 설정 사이드바 ════════ *@
        <MudItem xs="12" md="3">
            <div class="wb-panel pa-3">

                @* ── 1. 세션 ── *@
                <div class="d-flex align-center mb-2" style="gap:8px;">
                    <MudIcon Icon="@Icons.Material.Filled.Cable" Size="Size.Small"
                             Color="@(_session != null ? Color.Success : Color.Primary)" />
                    <span class="wb-panel-title">Session</span>
                    <MudSpacer />
                    @if (_session != null)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text"
                                 Class="ma-0">connected</MudChip>
                    }
                </div>

                <div class="wb-code mb-3" style="font-size:.72rem;">
                    <span style="color:var(--mud-palette-text-secondary);">my socket</span><br />
                    @_mySocketPath
                </div>

                <MudTextField @bind-Value="_socketPath"
                              Label="연결할 소켓 경로" Placeholder="/var/run/dds-ambassador-peer/grpc.sock"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2"
                              Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Shortcut"
                              AdornmentAriaLabel="기본 피어 소켓 경로" OnAdornmentClick="FillPeerSocketPath" />

                <MudNumericField @bind-Value="_timeoutSeconds" Label="타임아웃 (초)"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="300" Class="mb-2" />

                @if (_session == null)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                               OnClick="ConnectSession" Disabled="_connecting"
                               StartIcon="@Icons.Material.Filled.Link">
                        @if (_connecting)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <text>연결 중…</text>
                        }
                        else
                        {
                            <text>세션 연결</text>
                        }
                    </MudButton>
                }
                else
                {
                    <div class="wb-code mb-2" style="font-size:.72rem;">
                        <span style="color:var(--mud-palette-success);">● session @_session.SessionId[..8]</span><br />
                        @_session.UnixSocketPath
                    </div>
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" FullWidth="true"
                               StartIcon="@Icons.Material.Filled.LinkOff" OnClick="DisconnectSession">
                        연결 해제
                    </MudButton>
                }

                <MudDivider Class="my-4" />

                @* ── 2. Proto ── *@
                <div class="d-flex align-center mb-2" style="gap:8px;">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small"
                             Color="@(_services.Count > 0 ? Color.Success : Color.Default)" />
                    <span class="wb-panel-title">Proto</span>
                    <MudSpacer />
                    @if (_services.Count > 0)
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text"
                                 Class="ma-0">@_services.Count svc</MudChip>
                    }
                </div>

                @if (_session == null)
                {
                    <div class="wb-empty">세션 연결 후 proto가 로드됩니다</div>
                }
                else
                {
                    <MudFileUpload T="IBrowserFile" FilesChanged="OnProtoFileSelected" Accept=".proto">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Outlined" FullWidth="true"
                                       StartIcon="@Icons.Material.Filled.UploadFile">
                                다른 .proto 업로드
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                }

                <MudDivider Class="my-4" />

                @* ── 3. 메서드 ── *@
                <div class="d-flex align-center mb-2" style="gap:8px;">
                    <MudIcon Icon="@Icons.Material.Filled.Api" Size="Size.Small"
                             Color="@(_selectedMethod != null ? Color.Success : Color.Default)" />
                    <span class="wb-panel-title">Method</span>
                </div>

                @if (_services.Count == 0)
                {
                    <div class="wb-empty">로드된 서비스가 없습니다</div>
                }
                else
                {
                    <MudSelect T="ServiceMetadata" Label="서비스" @bind-Value="_selectedService"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-2"
                               ToStringFunc="@(s => s?.ServiceName ?? string.Empty)">
                        @foreach (var svc in _services)
                        {
                            <MudSelectItem T="ServiceMetadata" Value="svc">@svc.ServiceName</MudSelectItem>
                        }
                    </MudSelect>

                    <MudSelect T="MethodMetadata" Label="메서드" Value="_selectedMethod"
                               ValueChanged="@((MethodMetadata? m) => OnMethodSelected(m))"
                               Variant="Variant.Outlined" Margin="Margin.Dense"
                               Disabled="_selectedService == null"
                               ToStringFunc="@(m => m?.MethodName ?? string.Empty)">
                        @foreach (var method in _selectedService?.Methods ?? [])
                        {
                            <MudSelectItem T="MethodMetadata" Value="method">
                                @method.MethodName
                            </MudSelectItem>
                        }
                    </MudSelect>

                    @if (_selectedMethod != null)
                    {
                        <div class="wb-panel wb-rpc-accent @RpcCss(_selectedMethod.RpcType) pa-2 mt-2">
                            <MudChip T="string" Size="Size.Small" Color="@RpcTypeColor(_selectedMethod.RpcType)"
                                     Variant="Variant.Text" Class="ma-0 mb-1">@_selectedMethod.RpcType</MudChip>
                            <div class="wb-mono" style="font-size:.72rem;line-height:1.6;">
                                <span style="color:var(--mud-palette-text-secondary);">in </span>@_selectedMethod.InputType<br />
                                <span style="color:var(--mud-palette-text-secondary);">out</span> @_selectedMethod.OutputType
                            </div>
                            @if (!string.IsNullOrEmpty(_selectedMethod.InputSchema))
                            {
                                <MudExpansionPanels Class="mt-2" Elevation="0">
                                    <MudExpansionPanel Text="입력 스키마" Dense="true">
                                        <CodeBlock Text="@_selectedMethod.InputSchema" ShowCopy="true" MaxHeight="180px" />
                                    </MudExpansionPanel>
                                </MudExpansionPanels>
                            }
                        </div>
                    }
                }
            </div>
        </MudItem>

        @* ════════ 중앙: 요청 ════════ *@
        <MudItem xs="12" md="5">
            <div class="wb-panel pa-3">
                <div class="d-flex align-center mb-3" style="gap:8px;">
                    <MudIcon Icon="@Icons.Material.Filled.NorthEast" Size="Size.Small" Color="Color.Primary" />
                    <span class="wb-panel-title">Request</span>
                    <MudSpacer />
                    @if (_schemaFields.Count > 0)
                    {
                        <MudToggleGroup T="bool" Value="_rawJsonMode" ValueChanged="OnRawModeChanged"
                                        Color="Color.Primary" Size="Size.Small" CheckMark="false"
                                        SelectionMode="SelectionMode.SingleSelection">
                            <MudToggleItem Value="false" Text="Form" />
                            <MudToggleItem Value="true" Text="JSON" />
                        </MudToggleGroup>
                    }
                </div>

                @if (_selectedMethod == null)
                {
                    <div class="wb-empty">
                        <MudIcon Icon="@Icons.Material.Outlined.TouchApp" Class="mb-2" />
                        <div>좌측에서 세션 연결 → 메서드를 선택하세요</div>
                    </div>
                }
                else
                {
                    @if (!_rawJsonMode && _schemaFields.Count > 0)
                    {
                        <div class="wb-scroll mb-3" style="max-height:46vh;overflow-y:auto;">
                            @foreach (var field in _schemaFields)
                            {
                                <div class="mb-2">
                                    <SchemaFormField Field="field" OnChanged="@BuildJsonFromForm" />
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <MudTextField @bind-Value="_requestJson" Label="요청 JSON" Variant="Variant.Outlined"
                                      Lines="12" FullWidth="true" Class="mb-3 wb-mono"
                                      Style="font-size:.8rem;" />
                    }

                    @if (IsBidi || IsClientStream)
                    {
                        <div class="d-flex flex-wrap mb-2" style="gap:8px;">
                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.PlayArrow"
                                       Disabled="@(_session == null || _streamOpen)" OnClick="StartStream">
                                스트림 시작
                            </MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Send"
                                       Disabled="@(!_streamOpen)" OnClick="SendStreamMessage">
                                메시지 전송
                            </MudButton>
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Stop"
                                       Disabled="@(!_streamOpen)" OnClick="CloseStream">
                                종료
                            </MudButton>
                        </div>
                        @if (_streamOpen && _streamId != null)
                        {
                            <div class="wb-panel wb-rpc-accent wb-rpc-bidi pa-2 mb-2 d-flex align-center"
                                 style="gap:10px;">
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Color="Color.Secondary" />
                                <MudText Typo="Typo.caption">
                                    <b>스트림 활성</b> · <span class="wb-mono">@_streamId![..8]</span> · 전송 @_sentCount 건
                                </MudText>
                            </div>
                        }

                        @if (_streamRecv.Count > 0)
                        {
                            <div class="d-flex align-center mb-1" style="gap:8px;">
                                <MudIcon Icon="@Icons.Material.Filled.SouthWest" Size="Size.Small"
                                         Color="Color.Secondary" />
                                <span class="wb-panel-title">Stream ← 수신</span>
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">
                                    @_streamRecv.Count
                                </MudChip>
                            </div>
                            <div class="wb-scroll mb-2" style="max-height:28vh;overflow-y:auto;">
                                @foreach (var m in ((IEnumerable<string>)_streamRecv).Reverse().Take(50))
                                {
                                    <pre class="wb-code wb-scroll wb-code--accent mb-1" style="max-height:140px;">@m</pre>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                                   StartIcon="@Icons.Material.Filled.Send"
                                   Disabled="@(_session == null || _requesting)" OnClick="SendRequest">
                            @if (_requesting)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <text>전송 중…</text>
                            }
                            else
                            {
                                <text>전송</text>
                            }
                        </MudButton>
                    }

                    @if (!string.IsNullOrEmpty(_responseText))
                    {
                        <MudDivider Class="my-3" />
                        <CodeBlock Title="Response" Text="@_responseText" Accent="true" MaxHeight="32vh" />
                    }
                }
            </div>
        </MudItem>

        @* ════════ 우측: 수신 ════════ *@
        <MudItem xs="12" md="4">
            <div class="wb-panel pa-3">
                <div class="d-flex align-center mb-3" style="gap:8px;">
                    <MudIcon Icon="@Icons.Material.Filled.SouthWest" Size="Size.Small" Color="Color.Secondary" />
                    <span class="wb-panel-title">Incoming</span>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">
                        @_incomingCalls.Count
                    </MudChip>
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteSweep" Size="Size.Small"
                                   title="수신 목록 비우기" OnClick="@(() => _incomingCalls.Clear())" />
                </div>

                @if (_incomingCalls.Count == 0)
                {
                    <div class="wb-empty">
                        <MudIcon Icon="@Icons.Material.Outlined.Sensors" Class="mb-2" />
                        <div>이 인스턴스의 UDS 서버 수신 호출이<br />실시간으로 표시됩니다</div>
                    </div>
                }
                else
                {
                    <div class="wb-scroll" style="max-height:calc(100vh - 200px);overflow-y:auto;">
                        @foreach (var call in _incomingCalls.AsEnumerable().Reverse())
                        {
                            <div class="wb-panel wb-rpc-accent @RpcCss(call.Type) pa-2 mb-2">
                                <div class="d-flex align-center mb-1" style="gap:8px;">
                                    <span class="wb-mono" style="font-size:.68rem;color:var(--mud-palette-text-disabled);">
                                        @call.CallId[..8]
                                    </span>
                                    <span class="wb-mono" style="font-size:.78rem;font-weight:600;color:var(--wb-rpc);">
                                        @($"{call.Service.Split('.').Last()}.{call.Method}")
                                    </span>
                                    <MudSpacer />
                                    @if (!string.IsNullOrEmpty(call.Result))
                                    {
                                        <MudTooltip Text="@call.Result">
                                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle"
                                                     Size="Size.Small" Color="Color.Success" />
                                        </MudTooltip>
                                        <span style="font-size:.7rem;color:var(--mud-palette-text-secondary);">
                                            @call.Frames.Count f
                                        </span>
                                    }
                                    else
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                    }
                                </div>

                                @if (call.Frames.Count > 0)
                                {
                                    @if (call.Frames.Count > 1)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Default"
                                                   Class="pa-0" Style="min-height:0;font-size:.7rem;"
                                                   OnClick="@(() => call.ShowAllFrames = !call.ShowAllFrames)">
                                            @(call.ShowAllFrames ? "최근만 ▲" : $"이전 {call.Frames.Count - 1}건 ▼")
                                        </MudButton>
                                    }
                                    @if (call.ShowAllFrames)
                                    {
                                        @for (int fi = 0; fi < call.Frames.Count - 1; fi++)
                                        {
                                            <pre class="wb-code wb-scroll mt-1" style="max-height:90px;font-size:.68rem;opacity:.6;">@call.Frames[fi]</pre>
                                        }
                                    }
                                    <pre class="wb-code wb-scroll wb-code--accent mt-1" style="max-height:180px;">@call.Frames.Last()</pre>
                                }
                                else
                                {
                                    <span style="font-size:.72rem;color:var(--mud-palette-text-disabled);">수신 대기 중…</span>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </MudItem>

        @* ════════ 하단: 로그 ════════ *@
        <MudItem xs="12">
            <div class="wb-panel pa-2">
                <div class="d-flex align-center mb-1" style="gap:8px;">
                    <MudIconButton Icon="@(_logsExpanded ? Icons.Material.Filled.ExpandMore : Icons.Material.Filled.ChevronRight)"
                                   Size="Size.Small" OnClick="@(() => _logsExpanded = !_logsExpanded)" />
                    <MudIcon Icon="@Icons.Material.Filled.Terminal" Size="Size.Small" />
                    <span class="wb-panel-title">Logs</span>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0">@_logs.Count</MudChip>
                    <MudSpacer />
                    <MudIconButton Icon="@Icons.Material.Filled.DeleteSweep" Size="Size.Small"
                                   title="로그 비우기" OnClick="@(() => _logs.Clear())" />
                </div>
                @if (_logsExpanded)
                {
                    <div class="wb-code wb-scroll" style="max-height:200px;">
                        @if (_logs.Count == 0)
                        {
                            <span style="color:var(--mud-palette-text-disabled);">로그 없음</span>
                        }
                        else
                        {
                            @foreach (var log in _logs.AsEnumerable().Reverse())
                            {
                                <div class="d-flex" style="gap:8px;align-items:flex-start;line-height:1.7;">
                                    <MudIcon Icon="@LogIcon(log.Level)" Size="Size.Small"
                                             Style="@($"font-size:14px;color:{LogColorVar(log.Level)};flex:none;")" />
                                    <span style="color:var(--mud-palette-text-disabled);">@log.Time.ToString("HH:mm:ss")</span>
                                    <span style="color:@LogColorVar(log.Level);">@log.Text</span>
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        </MudItem>

    </MudGrid>
</div>

@code {
    // ── 상태 ──────────────────────────────────────────────────────────────────
    private string _mySocketPath = "로딩 중...";
    private string _socketPath = "/var/run/dds-ambassador-peer/grpc.sock";
    private int _timeoutSeconds = 30;
    private bool _connecting;
    private bool _requesting;

    private GrpcSession? _session;
    private List<ServiceMetadata> _services = [];
    private ServiceMetadata? _selectedService;
    private MethodMetadata? _selectedMethod;

    private string _requestJson = "{}";
    private string _responseText = string.Empty;

    // 스트리밍
    private bool _streamOpen;
    private string? _streamId;
    private int _sentCount;
    private List<string> _streamRecv = []; // bidi 서버→클라 실시간 수신
    private const int MaxStreamRecv = 500;

    // 스키마 폼
    private List<SchemaField> _schemaFields = [];
    private bool _rawJsonMode = false;

    // 수신 패널
    private List<IncomingCallVm> _incomingCalls = [];

    // 로그
    private List<LogEntry> _logs = [];
    private bool _logsExpanded = true;

    // ── UI 배치 업데이트 (고주파 수신 대응) ──────────────────────────────────
    // 200Hz+ 메시지가 와도 StateHasChanged는 20Hz(50ms)로만 호출됨
    private readonly System.Collections.Concurrent.ConcurrentQueue<Action> _pendingUiActions = new();
    private PeriodicTimer? _uiTimer;
    private readonly CancellationTokenSource _cts = new();
    private const int MaxIncomingCalls = 100;
    private const int MaxFramesPerCall  = 1000;

    // ── 헬퍼 ──────────────────────────────────────────────────────────────────
    private bool IsBidi => _selectedMethod?.RpcType == "BidirectionalStreaming";
    private bool IsClientStream => _selectedMethod?.RpcType == "ClientStreaming";

    private enum LogLevel { Info, Success, Warn, Error, Send }

    private Color RpcTypeColor(string? type) => type switch
    {
        "Unary" => Color.Success,
        "ServerStreaming" => Color.Info,
        "ClientStreaming" => Color.Warning,
        "BidirectionalStreaming" => Color.Secondary,
        _ => Color.Default
    };

    // CSS 클래스로 RPC 색 액센트 (--wb-rpc 변수 + 좌측 보더). 하드코딩 hex 제거.
    private static string RpcCss(string? type) => type switch
    {
        "Unary" => "wb-rpc-unary",
        "ServerStreaming" => "wb-rpc-server",
        "ClientStreaming" => "wb-rpc-client",
        "BidirectionalStreaming" => "wb-rpc-bidi",
        _ => string.Empty
    };

    private static string LogColorVar(LogLevel l) => l switch
    {
        LogLevel.Success => "var(--mud-palette-success)",
        LogLevel.Warn    => "var(--mud-palette-warning)",
        LogLevel.Error   => "var(--mud-palette-error)",
        LogLevel.Send    => "var(--mud-palette-info)",
        _                => "var(--mud-palette-text-secondary)"
    };

    private static string LogIcon(LogLevel l) => l switch
    {
        LogLevel.Success => Icons.Material.Filled.CheckCircle,
        LogLevel.Warn    => Icons.Material.Filled.Warning,
        LogLevel.Error   => Icons.Material.Filled.Error,
        LogLevel.Send    => Icons.Material.Filled.NorthEast,
        _                => Icons.Material.Filled.Info
    };

    private void Log(string text, LogLevel level = LogLevel.Info) =>
        _logs.Add(new LogEntry(DateTime.Now, text, level));

    private void OnRawModeChanged(bool raw)
    {
        _rawJsonMode = raw;
        if (raw) BuildJsonFromForm();
        StateHasChanged();
    }

    // ── 생명주기 ──────────────────────────────────────────────────────────────
    protected override async Task OnInitializedAsync()
    {
        _mySocketPath = Environment.GetEnvironmentVariable("UDS_SOCKET_PATH")
            ?? Configuration["GrpcWorkbench:UdsSocketPath"]
            ?? "(설정 없음)";

        Notify.CallStarted += OnCallStarted;
        Notify.StreamMessageReceived += OnStreamMessageReceived;
        Notify.CallEnded += OnCallEnded;

        // 20Hz UI 갱신 타이머 시작 — 고주파 메시지 배치 처리
        _uiTimer = new PeriodicTimer(TimeSpan.FromMilliseconds(50));
        _ = Task.Run(async () =>
        {
            try
            {
                while (await _uiTimer.WaitForNextTickAsync(_cts.Token))
                {
                    if (!_pendingUiActions.IsEmpty)
                        await InvokeAsync(() =>
                        {
                            while (_pendingUiActions.TryDequeue(out var act)) act();
                            StateHasChanged();
                        });
                }
            }
            catch (OperationCanceledException) { }
        });

        await TryLoadDefaultProtoServices();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await RestoreFromLocalStorage();
    }

    private async Task RestoreFromLocalStorage()
    {
        try
        {
            var sp = await JS.InvokeAsync<string?>("localStorage.getItem", "wb_socketPath");
            if (!string.IsNullOrEmpty(sp)) _socketPath = sp;

            var to = await JS.InvokeAsync<string?>("localStorage.getItem", "wb_timeout");
            if (int.TryParse(to, out var t)) _timeoutSeconds = t;

            var rj = await JS.InvokeAsync<string?>("localStorage.getItem", "wb_requestJson");
            if (!string.IsNullOrEmpty(rj)) _requestJson = rj;

            var svcName = await JS.InvokeAsync<string?>("localStorage.getItem", "wb_service");
            var mtdName = await JS.InvokeAsync<string?>("localStorage.getItem", "wb_method");
            if (!string.IsNullOrEmpty(svcName))
            {
                _selectedService = _services.FirstOrDefault(s => s.ServiceName == svcName);
                if (_selectedService != null && !string.IsNullOrEmpty(mtdName))
                {
                    var method = _selectedService.Methods.FirstOrDefault(m => m.MethodName == mtdName);
                    if (method != null) OnMethodSelected(method);
                }
            }

            StateHasChanged();
        }
        catch { /* localStorage 접근 실패 시 무시 */ }
    }

    private async Task SaveToLocalStorage()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "wb_socketPath", _socketPath);
            await JS.InvokeVoidAsync("localStorage.setItem", "wb_timeout", _timeoutSeconds.ToString());
            await JS.InvokeVoidAsync("localStorage.setItem", "wb_requestJson", _requestJson);
            await JS.InvokeVoidAsync("localStorage.setItem", "wb_service", _selectedService?.ServiceName ?? "");
            await JS.InvokeVoidAsync("localStorage.setItem", "wb_method", _selectedMethod?.MethodName ?? "");
        }
        catch { }
    }

    private async Task TryLoadDefaultProtoServices()
    {
        try
        {
            var protoBytes = await ReadDefaultProtoBytesAsync();
            _services = await ProtoLoader.LoadProtoServicesAsync(protoBytes);
            Notify.RegisterServices(_services);
            // 송신 시 동적 컴파일을 미리 warm-up → 첫 스트림 open이 빠르다
            _ = Task.Run(() => ProtoCompiler.CompileProtoToAssemblyAsync(protoBytes));
            Log($"DDSSim.proto 파싱 완료: {_services.Count}개 서비스", LogLevel.Success);
        }
        catch (Exception ex)
        {
            Log($"DDSSim.proto 파싱 실패: {ex.Message}", LogLevel.Error);
        }
    }

    // wwwroot/proto/DDSSim.proto를 디스크에서 직접 읽는다.
    // (이전엔 자기 자신에게 HTTP 루프백 요청 + ASPNETCORE_URLS 포트 파싱에 의존했음)
    private async Task<byte[]> ReadDefaultProtoBytesAsync()
    {
        var path = Path.Combine(WebHostEnv.WebRootPath, "proto", "DDSSim.proto");
        return await File.ReadAllBytesAsync(path);
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        _uiTimer?.Dispose();
        Notify.CallStarted -= OnCallStarted;
        Notify.StreamMessageReceived -= OnStreamMessageReceived;
        Notify.CallEnded -= OnCallEnded;
    }

    // ── 알림 핸들러 (미들웨어 → UI) ──────────────────────────────────────────
    // 이벤트 핸들러: 큐에만 적재, StateHasChanged는 타이머가 일괄 처리
    private void OnCallStarted(IncomingCallStartedEvent e) =>
        _pendingUiActions.Enqueue(() =>
        {
            if (_incomingCalls.Count >= MaxIncomingCalls) _incomingCalls.RemoveAt(0);
            _incomingCalls.Add(new IncomingCallVm(e.CallId, e.Service, e.Method, e.Type));
        });

    private void OnStreamMessageReceived(IncomingStreamMessageEvent e) =>
        _pendingUiActions.Enqueue(() =>
        {
            var call = _incomingCalls.FirstOrDefault(c => c.CallId == e.CallId);
            if (call == null) return;
            if (call.Frames.Count >= MaxFramesPerCall) call.Frames.RemoveAt(0);
            call.Frames.Add($"[{e.FrameIndex}] {e.Data}");
        });

    private void OnCallEnded(IncomingCallEndedEvent e) =>
        _pendingUiActions.Enqueue(() =>
        {
            var call = _incomingCalls.FirstOrDefault(c => c.CallId == e.CallId);
            if (call != null) call.Result = e.Res;
        });

    // ── 세션 연결 ─────────────────────────────────────────────────────────────
    private void DisconnectSession()
    {
        if (_session == null) return;
        ChannelProvider.ReleaseChannel(_session);
        SessionService.DeleteSession(_session.SessionId);
        Ui.SetConnection(false, null);
        _session = null;
        _streamOpen = false;
        _streamId = null;
        _sentCount = 0;
        Log("세션 연결 해제", LogLevel.Warn);
    }

    private void FillPeerSocketPath() =>
        _socketPath = "/var/run/dds-ambassador-peer/grpc.sock";

    private async Task ConnectSession()
    {
        if (string.IsNullOrWhiteSpace(_socketPath))
        {
            Snackbar.Add("소켓 경로를 입력하세요.", Severity.Warning);
            return;
        }

        _connecting = true;
        try
        {
            _session = SessionService.CreateSession(_socketPath);
            Ui.SetConnection(true, _socketPath);
            Log($"세션 연결: {_session.SessionId[..8]} / {_socketPath}", LogLevel.Success);
            await SaveToLocalStorage();
            await UploadDefaultProto();
        }
        catch (Exception ex)
        {
            Log($"세션 연결 실패: {ex.Message}", LogLevel.Error);
            Snackbar.Add($"연결 실패: {ex.Message}", Severity.Error);
        }
        finally
        {
            _connecting = false;
        }
    }

    private async Task UploadDefaultProto()
    {
        try
        {
            var protoBytes = await ReadDefaultProtoBytesAsync();
            _services = await ProtoLoader.LoadProtoServicesAsync(protoBytes);
            Notify.RegisterServices(_services);
            await SessionService.UpdateSessionProtoAsync(_session!.SessionId, protoBytes, "DDSSim.proto");
            _session.Services = _services;
            _ = Task.Run(() => ProtoCompiler.CompileProtoToAssemblyAsync(protoBytes));
            Log($"DDSSim.proto 로드: {_services.Count}개 서비스 (컴파일 warm-up)", LogLevel.Success);
        }
        catch (Exception ex)
        {
            Log($"DDSSim.proto 로드 실패: {ex.Message}", LogLevel.Error);
        }
    }

    // ── Proto 파일 업로드 ─────────────────────────────────────────────────────
    private async Task OnProtoFileSelected(IBrowserFile file)
    {
        if (_session == null) return;
        try
        {
            using var ms = new MemoryStream();
            await file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024).CopyToAsync(ms);
            var bytes = ms.ToArray();
            _services = await ProtoLoader.LoadProtoServicesAsync(bytes);
            // 수신 패널의 RPC 타입 조회가 업로드된 proto 기준이 되도록 재등록
            Notify.RegisterServices(_services);
            await SessionService.UpdateSessionProtoAsync(_session.SessionId, bytes, file.Name);
            _session.Services = _services;
            _selectedService = null;
            _selectedMethod = null;
            // 기본 proto 경로와 동일하게 동적 컴파일 warm-up (첫 송신 지연 제거)
            _ = Task.Run(() => ProtoCompiler.CompileProtoToAssemblyAsync(bytes));
            Log($"{file.Name} 로드: {_services.Count}개 서비스", LogLevel.Success);
            Snackbar.Add($"{file.Name} 로드 완료", Severity.Success);
        }
        catch (Exception ex)
        {
            Log($"파일 로드 실패: {ex.Message}", LogLevel.Error);
            Snackbar.Add($"파일 로드 실패: {ex.Message}", Severity.Error);
        }
    }

    // ── Unary / Server Streaming 전송 ─────────────────────────────────────────
    private async Task SendRequest()
    {
        if (_session == null || _selectedMethod == null) return;
        _requesting = true;
        _responseText = string.Empty;
        try
        {
            var payload = BuildPayload();
            if (_selectedMethod.RpcType == "ServerStreaming")
            {
                var msgs = new List<string>();
                await StreamingService.ExecuteServerStreamingAsync(
                    payload, _session,
                    async msg =>
                    {
                        msgs.Add(msg);
                        await InvokeAsync(StateHasChanged);
                    },
                    async _ => await InvokeAsync(StateHasChanged));
                _responseText = string.Join("\n---\n", msgs);
                Log($"ServerStreaming 완료 ({msgs.Count}건)", LogLevel.Success);
            }
            else
            {
                var result = await UnaryGrpcService.ExecuteUnaryCallAsync(payload, _session);
                _responseText = result.IsSuccess ? result.ResponseJson : result.ErrorMessage ?? "오류";
                Log(result.IsSuccess
                    ? $"응답 수신 ({result.ElapsedMilliseconds}ms)"
                    : $"실패: {result.ErrorMessage}",
                    result.IsSuccess ? LogLevel.Success : LogLevel.Error);
            }
        }
        catch (Exception ex)
        {
            Log($"전송 실패: {ex.Message}", LogLevel.Error);
        }
        finally
        {
            _requesting = false;
        }
    }

    // ── Bidi / Client Streaming ───────────────────────────────────────────────
    private async Task StartStream()
    {
        if (_session == null || _selectedMethod == null) return;
        _sentCount = 0;
        _streamRecv = [];
        try
        {
            // bidi: 서버→클라 메시지를 닫기 전 실시간 표시 (고주파 배치 큐 경유)
            _streamId = await StreamingService.OpenStreamAsync(BuildPayload(), _session,
                json =>
                {
                    _pendingUiActions.Enqueue(() =>
                    {
                        if (_streamRecv.Count >= MaxStreamRecv) _streamRecv.RemoveAt(0);
                        _streamRecv.Add(json);
                    });
                    return Task.CompletedTask;
                });
            _streamOpen = true;
            Log($"스트림 시작: {_streamId![..8]}", LogLevel.Send);
        }
        catch (Exception ex)
        {
            Log($"스트림 시작 실패: {ex.Message}", LogLevel.Error);
        }
    }

    private async Task SendStreamMessage()
    {
        if (!_streamOpen || _streamId == null) return;
        try
        {
            await StreamingService.WriteMessageAsync(_streamId, _requestJson);
            _sentCount++;
            Log($"전송 #{_sentCount}", LogLevel.Send);
        }
        catch (Exception ex)
        {
            Log($"전송 실패: {ex.Message}", LogLevel.Error);
        }
    }

    private async Task CloseStream()
    {
        if (_streamId == null) return;
        try
        {
            var result = await StreamingService.CloseStreamAsync(_streamId);
            _streamOpen = false;
            Log(result.IsSuccess
                ? $"스트림 종료 (수신 {result.Messages?.Count ?? 0}건)"
                : $"스트림 오류: {result.Error}",
                result.IsSuccess ? LogLevel.Warn : LogLevel.Error);
        }
        catch (Exception ex)
        {
            Log($"종료 실패: {ex.Message}", LogLevel.Error);
        }
    }

    private GrpcRequestPayload BuildPayload() => new()
    {
        SessionId = _session!.SessionId,
        ServiceName = _selectedService!.ServiceName,
        MethodName = _selectedMethod!.MethodName,
        RequestJson = _requestJson,
        TimeoutSeconds = _timeoutSeconds
    };

    // ── 스키마 폼 ──────────────────────────────────────────────────────────────
    private void OnMethodSelected(MethodMetadata? method)
    {
        _selectedMethod = method;
        _schemaFields = ParseSchemaFields(method?.InputSchema);
        _rawJsonMode = _schemaFields.Count == 0;
        if (_schemaFields.Count > 0)
            BuildJsonFromForm();
        else
            _requestJson = "{}";
        _ = SaveToLocalStorage();
    }

    private List<SchemaField> ParseSchemaFields(string? schema)
    {
        if (string.IsNullOrEmpty(schema)) return [];
        try
        {
            using var doc = JsonDocument.Parse(schema);
            return ParsePropertiesElement(doc.RootElement);
        }
        catch { return []; }
    }

    private static List<SchemaField> ParsePropertiesElement(JsonElement element)
    {
        if (!element.TryGetProperty("properties", out var props)) return [];
        var fields = new List<SchemaField>();
        foreach (var prop in props.EnumerateObject())
            fields.Add(ParseFieldElement(prop.Name, prop.Value));
        return fields;
    }

    private static SchemaField ParseFieldElement(string name, JsonElement schema)
    {
        var f = new SchemaField { Name = name };

        if (schema.TryGetProperty("enum", out var enumProp))
        {
            f.Type = "enum";
            f.EnumValues = enumProp.EnumerateArray().Select(e => e.GetString() ?? "").ToArray();
            f.Value = f.EnumValues.FirstOrDefault() ?? "";
        }
        else if (schema.TryGetProperty("type", out var typeProp))
        {
            var t = typeProp.GetString() ?? "string";
            f.Type = t;

            if (t == "object")
            {
                f.Children = ParsePropertiesElement(schema);
                f.Value = "{}";
            }
            else if (t == "array")
            {
                if (schema.TryGetProperty("items", out var itemsEl))
                    f.ItemTemplate = ParseFieldElement("", itemsEl);
                // ArrayItems는 비어있음 — 사용자가 UI에서 항목 추가
            }
            else
            {
                f.Value = t switch
                {
                    "integer" or "number" => "0",
                    "boolean" => "",
                    _ => ""
                };
            }
        }
        return f;
    }

    private void BuildJsonFromForm()
    {
        _requestJson = JsonSerializer.Serialize(
            BuildJsonObject(_schemaFields),
            new JsonSerializerOptions { WriteIndented = true });
        _ = SaveToLocalStorage();
    }

    private static Dictionary<string, object?> BuildJsonObject(List<SchemaField> fields)
    {
        var obj = new Dictionary<string, object?>();
        foreach (var f in fields)
            obj[f.Name] = BuildFieldValue(f);
        return obj;
    }

    private static object? BuildFieldValue(SchemaField f) => f.Type switch
    {
        "boolean" => f.BoolValue,
        "integer" => long.TryParse(f.Value, out var l) ? l : 0L,
        "number"  => double.TryParse(f.Value, System.Globalization.NumberStyles.Any,
                         System.Globalization.CultureInfo.InvariantCulture, out var d) ? d : 0.0,
        "object" when f.Children.Count > 0 => BuildJsonObject(f.Children),
        "object"  => TryParseRaw(f.Value),
        "array" when f.ItemTemplate != null => f.ArrayItems.Select(BuildFieldValue).ToArray(),
        "array"   => TryParseRaw(f.Value),
        _         => (object?)f.Value
    };

    private static object? TryParseRaw(string value)
    {
        try
        {
            using var doc = JsonDocument.Parse(value);
            return doc.RootElement.Clone();
        }
        catch { return value; }
    }

    // ── 내부 VM 타입 ──────────────────────────────────────────────────────────
    private record LogEntry(DateTime Time, string Text, LogLevel Level);

    private sealed class IncomingCallVm(string callId, string service, string method, string type)
    {
        public string CallId { get; } = callId;
        public string Service { get; } = service;
        public string Method { get; } = method;
        public string Type { get; } = type;
        public List<string> Frames { get; } = [];
        public string? Result { get; set; }
        public bool ShowAllFrames { get; set; }
    }
}
