@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using ASAP.Models.Session
@using ASAP.Services
@inject IDdsSessionService DdsSessions
@inject UiStateService Ui
@inject ISnackbar Snackbar

<PageTitle>Signal Forge DDS</PageTitle>

<div class="wb-page pa-3">
    <div class="wb-session-shell mb-4">
        <div class="wb-session-tabs">
            @foreach (var session in _sessions)
            {
                <div class="wb-session-tab @(IsActive(session.SessionId) ? "is-active" : null)">
                    <button type="button" class="wb-session-tab-main"
                            @onclick="@(() => ActivateSession(session.SessionId))">
                        <span class="wb-session-tab-title">@SessionLabel(session)</span>
                        <span class="wb-session-tab-note">@SessionDetail(session)</span>
                    </button>
                    <button type="button" class="wb-session-tab-close" title="DDS 탭 닫기"
                            @onclick:stopPropagation="true"
                            @onclick="@(async () => await CloseSession(session.SessionId))">
                        <MudIcon Icon="@Icons.Material.Filled.Close" Size="Size.Small" />
                    </button>
                </div>
            }
            <button type="button"
                    class="wb-session-tab wb-session-tab--new @(_showCreateForm ? "is-active" : null)"
                    @onclick="ShowCreateForm">
                <span class="wb-session-tab-title">새 DDS 세션</span>
                <span class="wb-session-tab-note">Domain과 XML 설정</span>
            </button>
        </div>

        @if (_showCreateForm || _activeSession == null)
        {
            <div class="wb-panel wb-panel--contain pa-4 mt-3">
                <div class="wb-panel-kicker">DDS 세션</div>
                <div class="wb-panel-heading">Domain과 XML 설정으로 작업 공간을 엽니다</div>
                <div class="wb-inline-note mt-2">
                    DDS 발행·구독, 수신 데이터 확인, 트리거와 시나리오 자동화를 한 세션에서 관리합니다.
                </div>
                <div class="mt-3">
                    <DdsSessionCreateForm OnCreated="OnSessionCreated" OnCancelled="CancelCreate" />
                </div>
            </div>
        }
    </div>

    @foreach (var session in _sessions)
    {
        var isVisible = !_showCreateForm && string.Equals(_activeSession?.SessionId, session.SessionId, StringComparison.Ordinal);
        <div @key="session.SessionId" style="@(isVisible ? null : "display:none;")" aria-hidden="@(!isVisible)">
            @if (session.State == DdsSessionState.Active)
            {
                <DdsSessionPanel @key="session.SessionId" Session="session" IsVisible="isVisible" />
            }
            else
            {
                <MudAlert Severity="Severity.Warning">@session.State — @(session.CleanupError ?? "네이티브 자원 정리 중입니다. 대기 시간 초과는 정리를 취소하지 않습니다.")</MudAlert>
                <MudButton OnClick="RefreshSessions">상태 새로고침</MudButton>
            }
        </div>
    }
</div>

@code {
    private List<DdsSession> _sessions = [];
    private DdsSession? _activeSession;
    private bool _showCreateForm;
    // 공유 세션 객체는 백그라운드에서 바뀐다. 마지막으로 표시한 값은 객체 참조가 아닌 불변 값으로 보관한다.
    private (string Id, DdsSessionState State, string? Error)[] _renderedSessionStates = [];
    private readonly CancellationTokenSource _healthCancellation = new();
    private Task? _healthPolling;

    protected override void OnInitialized()
    {
        _healthPolling = PollConnectionHealthAsync();
        RefreshSessions();
        if (_sessions.Count > 0)
        {
            ActivateSession(_sessions[0].SessionId);
        }
        else
        {
            ShowCreateForm();
        }
    }

    // 외부에서 발생한 네이티브 연결 오류도 표시한다. 송수신 데이터 자체를 폴링하지 않는다.
    private async Task PollConnectionHealthAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(1));
        try
        {
            while (await timer.WaitForNextTickAsync(_healthCancellation.Token))
                await InvokeAsync(() =>
                {
                    if (_healthCancellation.IsCancellationRequested) return;
                    var previous = _renderedSessionStates;
                    RefreshSessions();
                    if (!previous.SequenceEqual(_renderedSessionStates)) StateHasChanged();
                });
        }
        catch (OperationCanceledException) when (_healthCancellation.IsCancellationRequested) { }
    }

    public async ValueTask DisposeAsync()
    {
        _healthCancellation.Cancel();
        if (_healthPolling is not null) await _healthPolling;
        _healthCancellation.Dispose();
    }

    private void RefreshSessions()
    {
        _sessions = DdsSessions.GetAll()
            .OrderBy(session => session.CreatedAt)
            .ToList();
        _renderedSessionStates = _sessions.Select(s => (s.SessionId, s.State, s.CleanupError)).ToArray();
    }

    private bool IsActive(string sessionId)
        => !_showCreateForm
            && string.Equals(_activeSession?.SessionId, sessionId, StringComparison.Ordinal);

    private void ShowCreateForm()
    {
        _showCreateForm = true;
        Ui.SetWorkspace("새 DDS 세션", "Domain과 XML 설정");
    }

    private Task CancelCreate()
    {
        if (_activeSession != null)
        {
            _showCreateForm = false;
            SetWorkspace(_activeSession);
        }

        return Task.CompletedTask;
    }

    private Task OnSessionCreated(DdsSession session)
    {
        RefreshSessions();
        ActivateSession(session.SessionId);
        return Task.CompletedTask;
    }

    private void ActivateSession(string sessionId)
    {
        var session = DdsSessions.GetAll().FirstOrDefault(s => s.SessionId == sessionId);
        if (session == null)
        {
            RefreshSessions();
            return;
        }

        _activeSession = session;
        _showCreateForm = false;
        SetWorkspace(session);
    }

    private async Task CloseSession(string sessionId)
    {
        try { await DdsSessions.DeleteAsync(sessionId); }
        catch (TimeoutException)
        {
            Snackbar.Add("종료 대기 시간이 초과되었습니다. 세션은 백그라운드에서 계속 정리됩니다.", Severity.Warning);
            RefreshSessions();
            return;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"세션 정리 실패: {ex.Message}", Severity.Error);
            RefreshSessions();
            return;
        }
        RefreshSessions();

        if (_activeSession?.SessionId == sessionId)
        {
            _activeSession = null;
            if (_sessions.Count > 0)
            {
                ActivateSession(_sessions[0].SessionId);
            }
            else
            {
                ShowCreateForm();
            }
        }
    }

    private void SetWorkspace(DdsSession session)
        => Ui.SetWorkspace(SessionLabel(session), SessionDetail(session));

    private static string SessionLabel(DdsSession session)
        => string.IsNullOrWhiteSpace(session.Name)
            ? $"DDS {session.SessionId[..8]}"
            : session.Name;

    private static string SessionDetail(DdsSession session)
        => $"Domain {session.Transport.DomainId} · {session.Topics.Count}개 토픽 · {session.State}";
}
