@inherits LayoutComponentBase

<MudThemeProvider Theme="_theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudText Typo="Typo.h6" Class="ml-2">🚀 gRPC Workbench</MudText>
        <MudSpacer />
        <MudText Typo="Typo.caption" Class="mr-2" Style="opacity:0.7">
            Bidirectional gRPC 테스트 도구
        </MudText>
    </MudAppBar>
    <MudMainContent Style="padding-top: 48px;">
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#1976D2",
            Secondary = "#455A64",
            Background = "#F5F5F5",
            Surface = "#FFFFFF",
            AppbarBackground = "#1565C0",
            AppbarText = "#FFFFFF",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#90CAF9",
            Background = "#121212",
            Surface = "#1E1E1E",
            AppbarBackground = "#1A237E",
        }
    };
}
